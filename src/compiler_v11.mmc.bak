တည်ဆောက် ကိန်း NK_CONTINUE_STMT = 109
တည်ဆောက် ကိန်း NK_PRINT_STMT = 110
တည်ဆောက် ကိန်း NK_ASSIGN = 111
တည်ဆောက် ကိန်း NK_EXPR_STMT = 112
တည်ဆောက် ကိန်း NK_IMPORT = 113
တည်ဆောက် ကိန်း NK_BINARY_OP = 200
