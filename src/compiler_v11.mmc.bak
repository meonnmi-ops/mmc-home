// ============================================================
// compiler_v11.mmc — MMC Self-Hosting Compiler v11.0
// ဘယ်သူနဲ့မှ မတု တကမ္ဘာလုံးက သုံးလို့ရတဲ့ နည်းပညာ အသစ်
// Written entirely in MMC (Myanmar Programming Language)
// No Python, No C — Pure MMC Technology
// (c) NyanLin AI Lab 2026
// ============================================================

// === Token Types ===
အစုအဝေး Token {
    type ကိန်း       // token type number
    value စာသား      // token value string
    line ကိန်း        // source line number
    col ကိန်း         // source column number
}

// === AST Node ===
အစုအဝေး ASTNode {
    kind ကိန်း        // node kind (VAR_DECL, FUNC_DEF, IF_STMT, etc.)
    data စာသား       // node data (variable name, function name, etc.)
    type_str စာသား   // type string (int, char*, double, etc.)
    children စာရင်း   // child nodes (as MMCArray of ASTNode*)
    value_num double  // numeric value for literals
    value_str စာသား   // string value for string literals
}

// === Compiler State ===
အစုအဝေး CompilerState {
    source စာသား         // input source code
    source_len ကိန်း       // source length
    pos ကိန်း             // current position in source
    line ကိန်း             // current line number
    col ကိန်း              // current column number
    tokens စာရင်း          // list of Token*
    token_pos ကိန်း        // current position in tokens
    output စာသား          // generated C code output
    struct_names စာရင်း    // list of struct name strings
    enum_names စာရင်း      // list of enum name strings
    fn_typedefs စာရင်း     // list of function typedef strings
    has_main ကိန်း         // whether main() function exists
    error_count ကိန်း      // number of errors
}

// === Constants: Token Types ===
တည်ဆောက် ကိန်း TT_EOF = 0
တည်ဆောက် ကိန်း TT_INT = 1
တည်ဆောက် ကိန်း TT_FLOAT = 2
တည်ဆောက် ကိန်း TT_STRING = 3
တည်ဆောက် ကိန်း TT_IDENT = 4
တည်ဆောက် ကိန်း TT_VAR = 5      // တည်ဆောက
တည်ဆောက် ကိန်း TT_FUNC = 6      // လုပ်ငန်း
တည်ဆောက် ကိန်း TT_IF = 7        // သုံးသပ်ချက်အရ
တည်ဆောက် ကိန်း TT_ELSE = 8      // မဟုတ်လျှင်
တည်ဆောက် ကိန်း TT_WHILE = 9     // ပြည့်အောင်
တည်ဆောက် ကိန်း TT_FOR = 10      // ထပ်ကာထပ်ကာ
တည်ဆောက် ကိန်း TT_RETURN = 11   // ပြန်ပေး
တည်ဆောက် ကိန်း TT_PRINT = 12    // ဖော်ပြ
တည်ဆောက် ကိန်း TT_CONTINUE = 13 // ဆက်လုပ်
တည်ဆောက် ကိန်း TT_BREAK = 14    // ရပ်
တည်ဆောက် ကိန်း TT_STRUCT = 15   // အစုအဝေး
တည်ဆောက် ကိန်း TT_IMPORT = 16   // သွင်းယူ
တည်ဆောက် ကိန်း TT_KYAN = 17     // ကိန်း (int type)
တည်ဆောက် ကိန်း TT_STR_TYPE = 18 // စာသား (char* type)
တည်ဆောက် ကိန်း TT_LIST = 19     // စာရင်း (MMCArray* type)
တည်ဆောက် ကိန်း TT_OBJ = 20      // အစု (struct instance type)
တည်ဆောက် ကိန်း TT_AND = 21       // နှင့် / &&
တည်ဆောက် ကိန်း TT_OR = 22        // သို့မဟုတ် / ||
တည်ဆောက် ကိန်း TT_PLUS = 23
တည်ဆောက် ကိန်း TT_MINUS = 24
တည်ဆောက် ကိန်း TT_STAR = 25
တည်ဆောက် ကိန်း TT_SLASH = 26
တည်ဆောက် ကိန်း TT_PERCENT = 27
တည်ဆောက် ကိန်း TT_ASSIGN = 28
တည်ဆောက် ကိန်း TT_EQ = 29       // ==
တည်ဆောက် ကိန်း TT_NEQ = 30      // !=
တည်ဆောက် ကိန်း TT_LT = 31
တည်ဆောက် ကိန်း TT_GT = 32
တည်ဆောက် ကိန်း TT_LTE = 33      // <=
တည်ဆောက် ကိန်း TT_GTE = 34      // >=
တည်ဆောက် ကိန်း TT_LPAREN = 35
တည်ဆောက် ကိန်း TT_RPAREN = 36
တည်ဆောက် ကိန်း TT_LBRACE = 37
တည်ဆောက် ကိန်း TT_RBRACE = 38
တည်ဆောက် ကိန်း TT_LBRACKET = 39
တည်ဆောက် ကိန်း TT_RBRACKET = 40
တည်ဆောက် ကိန်း TT_COMMA = 41
တည်ဆောက် ကိန်း TT_DOT = 42
တည်ဆောက် ကိန်း TT_ARROW = 43    // ->
တည်ဆောက် ကိန်း TT_SEMI = 44
တည်ဆောက် ကိန်း TT_NEWLINE = 45
တည်ဆောက် ကိန်း TT_MYANMAR_INT = 46
တည်ဆောက် ကိန်း TT_DOUBLE = 47    // ဒသမ (double type)
တည်ဆောက် ကိန်း TT_SWITCH = 48    // ပြောင်း (switch)
တည်ဆောက် ကိန်း TT_CASE = 49      // အခြေနေ (case)
တည်ဆောက် ကိန်း TT_DEFAULT = 50   // ပုံသေ (default)
တည်ဆောက် ကိန်း TT_ENUM = 51      // စာရင်းကောက် (enum)
တည်ဆောက် ကိန်း TT_BIT_AND = 52   // ♩ (bitwise AND)
တည်ဆောက် ကိန်း TT_BIT_OR = 53    // ♪ (bitwise OR)
တည်ဆောက် ကိန်း TT_BIT_XOR = 54   // ♫ (bitwise XOR)
တည်ဆောက် ကိန်း TT_BIT_NOT = 55   // ♬ (bitwise NOT)
တည်ဆောက် ကိန်း TT_SHL = 56       // ♭ (left shift)
တည်ဆောက် ကိန်း TT_SHR = 57       // ♯ (right shift)
တည်ဆောက် ကိန်း TT_ADDR_OF = 58   // ♮ (address-of)
တည်ဆောက် ကိန်း TT_GOTO = 59      // သွားမယ် (goto)
တည်ဆောက် ကိန်း TT_LABEL = 60     // အမှတ် (label)
တည်ဆောက် ကိန်း TT_CHAR = 61     // character literal

