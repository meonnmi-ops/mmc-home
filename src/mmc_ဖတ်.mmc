လုပ်ငန်း main() {
    သုံးသပ်ချက်အရ(mmc_array_size(knowledge_base) < 2) {
        printf("အသုံး: mmc_ဖတ် <ဖိုင်>\n")
        ပြန်ပေး 1
    }
    တည်ဆောက် စာသား ဖိုင် = mmc_array_get(knowledge_base, 1)
    တည်ဆောက် စာသား အကြောင်း = mmc_read_file(ဖိုင်)
    သုံးသပ်ချက်အရ(အကြောင်း == NULL) {
        printf("ဖိုင် မ ဖွင့်နိုင်ပါ: %s\n", ဖိုင်)
        ပြန်ပေး 1
    }
    printf("%s", အကြောင်း)
    ပြန်ပေး 0
}
