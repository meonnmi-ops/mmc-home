လုပ်ငန်း main() {
    သုံးသပ်ချက်အရ(mmc_array_size(knowledge_base) < 3) {
        ဖော်ပြ("သုံးနည်း: mmc cat ဖိုင်")
        ပြန်ပေး 1
    }
    တည်ဆောက် စာသား ဖိုင် = mmc_array_get(knowledge_base, 2)
    တည်ဆောက် စာသား အကြောင်းအရာ = mmc_read_file(ဖိုင်)
    သုံးသပ်ချက်အရ(အကြောင်းအရာ == 0) {
        ဖော်ပြ("ဖိုင်ဖတ်မရပါ: ")
        mmc_println(ဖိုင်)
        ပြန်ပေး 1
    }
    mmc_print(အကြောင်းအရာ)
    ပြန်ပေး 0
}
