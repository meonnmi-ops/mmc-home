လုပ်ငန်း main() {
    သုံးသပ်ချက်အရ(mmc_array_size(knowledge_base) < 2) {
        printf("အသုံး: mmc_ရေ <ဖိုင်>\n")
        ပြန်ပေး 1
    }
    တည်ဆောက် စာသား ဖိုင် = mmc_array_get(knowledge_base, 1)
    တည်ဆောက် စာသား အကြောင်း = mmc_read_file(ဖိုင်)
    သုံးသပ်ချက်အရ(အကြောင်း == NULL) {
        printf("ဖိုင် မ ဖွင့်နိုင်ပါ: %s\n", ဖိုင်)
        ပြန်ပေး 1
    }
    တည်ဆောက် ကိန်း bytes = mmc_string_length(အကြောင်း)
    တည်ဆောက် ကိန်း lines = 0
    တည်ဆောက် ကိန်း words = 0
    တည်ဆောက် ကိန်း in_word = 0
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < bytes) {
        တည်ဆောက် ကိန်း ch = အကြောင်း[i]
        သုံးသပ်ချက်အရ(ch == 10) {
            lines = lines + 1
        }
        သုံးသပ်ချက်အရ((ch == 32) သို့မဟုတ် (ch == 10) သို့မဟုတ် (ch == 9)) {
            သုံးသပ်ချက်အရ(in_word == 1) {
                words = words + 1
                in_word = 0
            }
        } မဟုတ်လျှင် {
            in_word = 1
        }
        i = i + 1
    }
    သုံးသပ်ချက်အရ(in_word == 1) {
        words = words + 1
    }
    printf("%d %d %d %s\n", lines, words, bytes, ဖိုင်)
    ပြန်ပေး 0
}
