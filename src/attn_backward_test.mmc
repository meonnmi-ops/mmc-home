// attn_backward_test.mmc — full attention block bwd vs PyTorch
extern "C" void* malloc(ကိန်း n)
extern "C" void* calloc(ကိန်း n, ကိန်း sz)
extern "C" void free(အစု p)
extern "C" ဒသမ sqrt(ဒသမ x)
extern "C" ဒသမ exp(ဒသမ x)
extern "C" ကိန်း printf(စာသား fmt, ...)
extern "C" void* fopen(စာသား path, စာသား mode)
extern "C" ကိန်း fread(အစု buf, ကိန်း sz, ကိန်း n, အစု stream)
extern "C" ကိန်း fwrite(အစု buf, ကိန်း sz, ကိန်း n, အစု stream)
extern "C" ကိန်း fclose(အစု stream)

လုပ်ငန်း attn_forward_bwd(
    ဒသမ* dWqkv, ဒသမ* dbqkv, ဒသမ* dWo, ဒသမ* dbo, ဒသမ* dXn,
    ဒသမ* Xn, ဒသမ* Wqkv, ဒသမ* bqkv, ဒသမ* Wo, ဒသမ* bo, ဒသမ* dY,
    ကိန်း T, ကိန်း D, ကိန်း H) ကိန်း {

    တည်ဆောက် ကိန်း HD = D / H
    တည်ဆောက် ဒသမ scale = 1.0 / sqrt(HD * 1.0)
    တည်ဆောက် ကိန်း t = 0
    တည်ဆောက် ကိန်း h = 0
    တည်ဆောက် ကိန်း i = 0
    တည်ဆောက် ကိန်း j = 0
    တည်ဆောက် ကိန်း k = 0
    တည်ဆောက် ကိန်း hd = 0
    တည်ဆောက် ကိန်း d1 = 0
    တည်ဆောက် ကိန်း d2 = 0

    // === FORWARD ===
    တည်ဆောက် ဒသမ* Q = calloc(T * D, 8)
    တည်ဆောက် ဒသမ* K = calloc(T * D, 8)
    တည်ဆောက် ဒသမ* V = calloc(T * D, 8)

    t = 0
    ပြည့်အောင်(t < T) {
        d1 = 0
        ပြည့်အောင်(d1 < D) {
            တည်ဆောက် ဒသမ sq = bqkv[d1]
            တည်ဆောက် ဒသမ sk = bqkv[D + d1]
            တည်ဆောက် ဒသမ sv = bqkv[2*D + d1]
            k = 0
            ပြည့်အောင်(k < D) {
                တည်ဆောက် ဒသမ xv = Xn[t*D + k]
                sq = sq + Wqkv[d1*D + k] * xv
                sk = sk + Wqkv[(D+d1)*D + k] * xv
                sv = sv + Wqkv[(2*D+d1)*D + k] * xv
                k = k + 1
            }
            Q[t*D+d1] = sq
            K[t*D+d1] = sk
            V[t*D+d1] = sv
            d1 = d1 + 1
        }
        t = t + 1
    }

    တည်ဆောက် ဒသမ* O = calloc(T * D, 8)
    တည်ဆောက် ဒသမ* Aall = calloc(H * T * T, 8)

    h = 0
    ပြည့်အောင်(h < H) {
        တည်ဆောက် ဒသမ* A = Aall + h * T * T
        i = 0
        ပြည့်အောင်(i < T) {
            တည်ဆောက် ဒသမ mx = -1000000000.0
            j = 0
            ပြည့်အောင်(j <= i) {
                တည်ဆောက် ဒသမ s = 0.0
                k = 0
                ပြည့်အောင်(k < HD) {
                    s = s + Q[i*D + h*HD + k] * K[j*D + h*HD + k]
                    k = k + 1
                }
                A[i*T + j] = s * scale
                သုံးသပ်ချက်အရ(A[i*T + j] > mx) {
                    mx = A[i*T + j]
                }
                j = j + 1
            }
            တည်ဆောက် ဒသမ se = 0.0
            j = 0
            ပြည့်အောင်(j <= i) {
                A[i*T + j] = exp(A[i*T + j] - mx)
                se = se + A[i*T + j]
                j = j + 1
            }
            j = 0
            ပြည့်အောင်(j <= i) {
                A[i*T + j] = A[i*T + j] / se
                j = j + 1
            }
            j = i + 1
            ပြည့်အောင်(j < T) {
                A[i*T + j] = 0.0
                j = j + 1
            }
            i = i + 1
        }
        // Oh[i, hd] = sum_j A[i,j] * V[j, h*HD+hd]
        i = 0
        ပြည့်အောင်(i < T) {
            hd = 0
            ပြည့်အောင်(hd < HD) {
                တည်ဆောက် ဒသမ s = 0.0
                j = 0
                ပြည့်အောင်(j < T) {
                    s = s + A[i*T + j] * V[j*D + h*HD + hd]
                    j = j + 1
                }
                O[i*D + h*HD + hd] = s
                hd = hd + 1
            }
            i = i + 1
        }
        h = h + 1
    }

    // === BACKWARD ===
    // dO = dY @ Wo    dWo = dY.T @ O    dbo = sum(dY)
    တည်ဆောက် ဒသမ* dO = calloc(T * D, 8)
    t = 0
    ပြည့်အောင်(t < T) {
        d1 = 0
        ပြည့်အောင်(d1 < D) {
            တည်ဆောက် ဒသမ dy = dY[t*D + d1]
            dbo[d1] = dbo[d1] + dy
            d2 = 0
            ပြည့်အောင်(d2 < D) {
                dWo[d1*D + d2] = dWo[d1*D + d2] + dy * O[t*D + d2]
                dO[t*D + d2] = dO[t*D + d2] + dy * Wo[d1*D + d2]
                d2 = d2 + 1
            }
            d1 = d1 + 1
        }
        t = t + 1
    }

    တည်ဆောက် ဒသမ* dQ = calloc(T * D, 8)
    တည်ဆောက် ဒသမ* dK = calloc(T * D, 8)
    တည်ဆောက် ဒသမ* dV = calloc(T * D, 8)

    h = 0
    ပြည့်အောင်(h < H) {
        တည်ဆောက် ဒသမ* A = Aall + h * T * T
        တည်ဆောက် ဒသမ* dA = calloc(T * T, 8)
        တည်ဆောက် ဒသမ* dVh = calloc(T * HD, 8)
        // dA[i,j] = sum_hd dOh[i,hd] * Vh[j,hd]
        i = 0
        ပြည့်အောင်(i < T) {
            j = 0
            ပြည့်အောင်(j < T) {
                တည်ဆောက် ဒသမ s = 0.0
                hd = 0
                ပြည့်အောင်(hd < HD) {
                    s = s + dO[i*D + h*HD + hd] * V[j*D + h*HD + hd]
                    hd = hd + 1
                }
                dA[i*T + j] = s
                j = j + 1
            }
            i = i + 1
        }
        // dVh[i,hd] = sum_j A[j,i] * dOh[j,hd]
        i = 0
        ပြည့်အောင်(i < T) {
            hd = 0
            ပြည့်အောင်(hd < HD) {
                တည်ဆောက် ဒသမ s = 0.0
                j = 0
                ပြည့်အောင်(j < T) {
                    s = s + A[j*T + i] * dO[j*D + h*HD + hd]
                    j = j + 1
                }
                dVh[i*HD + hd] = s
                hd = hd + 1
            }
            i = i + 1
        }
        // softmax bwd
        တည်ဆောက် ဒသမ* dS = calloc(T * T, 8)
        i = 0
        ပြည့်အောင်(i < T) {
            တည်ဆောက် ဒသမ sad = 0.0
            j = 0
            ပြည့်အောင်(j < T) {
                sad = sad + A[i*T + j] * dA[i*T + j]
                j = j + 1
            }
            j = 0
            ပြည့်အောင်(j < T) {
                dS[i*T + j] = A[i*T + j] * (dA[i*T + j] - sad)
                j = j + 1
            }
            i = i + 1
        }
        // dQh, dKh (with scale)
        တည်ဆောက် ဒသမ* dQh = calloc(T * HD, 8)
        တည်ဆောက် ဒသမ* dKh = calloc(T * HD, 8)
        i = 0
        ပြည့်အောင်(i < T) {
            k = 0
            ပြည့်အောင်(k < HD) {
                တည်ဆောက် ဒသမ s = 0.0
                j = 0
                ပြည့်အောင်(j < T) {
                    s = s + dS[i*T + j] * scale * K[j*D + h*HD + k]
                    j = j + 1
                }
                dQh[i*HD + k] = s
                k = k + 1
            }
            i = i + 1
        }
        i = 0
        ပြည့်အောင်(i < T) {
            k = 0
            ပြည့်အောင်(k < HD) {
                တည်ဆောက် ဒသမ s = 0.0
                j = 0
                ပြည့်အောင်(j < T) {
                    s = s + dS[j*T + i] * scale * Q[j*D + h*HD + k]
                    j = j + 1
                }
                dKh[i*HD + k] = s
                k = k + 1
            }
            i = i + 1
        }
        // write back
        i = 0
        ပြည့်အောင်(i < T) {
            k = 0
            ပြည့်အောင်(k < HD) {
                dQ[i*D + h*HD + k] = dQ[i*D + h*HD + k] + dQh[i*HD + k]
                dK[i*D + h*HD + k] = dK[i*D + h*HD + k] + dKh[i*HD + k]
                dV[i*D + h*HD + k] = dV[i*D + h*HD + k] + dVh[i*HD + k]
                k = k + 1
            }
            i = i + 1
        }
        free(dA) free(dVh) free(dS) free(dQh) free(dKh)
        h = h + 1
    }

    // === QKV matmul bwd: dWqkv = dQKV.T @ Xn, dbqkv = sum, dXn = dQKV @ Wqkv ===
    တည်ဆောက် ဒသမ* dQKV = calloc(T * 3 * D, 8)
    t = 0
    ပြည့်အောင်(t < T) {
        တည်ဆောက် ကိန်း d = 0
        ပြည့်အောင်(d < D) {
            dQKV[t*3*D + d] = dQ[t*D + d]
            dQKV[t*3*D + D + d] = dK[t*D + d]
            dQKV[t*3*D + 2*D + d] = dV[t*D + d]
            d = d + 1
        }
        t = t + 1
    }
    t = 0
    ပြည့်အောင်(t < T) {
        d1 = 0
        ပြည့်အောင်(d1 < 3*D) {
            တည်ဆောက် ဒသမ dy = dQKV[t*3*D + d1]
            dbqkv[d1] = dbqkv[d1] + dy
            d2 = 0
            ပြည့်အောင်(d2 < D) {
                dWqkv[d1*D + d2] = dWqkv[d1*D + d2] + dy * Xn[t*D + d2]
                dXn[t*D + d2] = dXn[t*D + d2] + dy * Wqkv[d1*D + d2]
                d2 = d2 + 1
            }
            d1 = d1 + 1
        }
        t = t + 1
    }

    free(Q) free(K) free(V) free(O) free(Aall)
    free(dO) free(dQ) free(dK) free(dV) free(dQKV)
    ပြန်ပေး 0
}

လုပ်ငန်း load_f64(စာသား path, ကိန်း n) အစု {
    တည်ဆောက် အစု buf = malloc(8 * n)
    သုံးသပ်ချက်အရ(buf == 0) { ပြန်ပေး 0 }
    တည်ဆောက် အစု fp = fopen(path, "rb")
    သုံးသပ်ချက်အရ(fp == 0) { free(buf) ပြန်ပေး 0 }
    fread(buf, 8, n, fp)
    fclose(fp)
    ပြန်ပေး buf
}

လုပ်ငန်း save_f64(စာသား path, အစု buf, ကိန်း n) ကိန်း {
    တည်ဆောက် အစု fp = fopen(path, "wb")
    သုံးသပ်ချက်အရ(fp == 0) { ပြန်ပေး -1 }
    fwrite(buf, 8, n, fp)
    fclose(fp)
    ပြန်ပေး 0
}

လုပ်ငန်း main() {
    တည်ဆောက် ကိန်း T = 8
    တည်ဆောက် ကိန်း D = 32
    တည်ဆောက် ကိန်း H = 4

    တည်ဆောက် စာသား B = "/data/data/com.termux/files/home/mmc_publish/ref/bwd_test"

    တည်ဆောက် အစု Xnp  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/aXn.bin", T * D)
    တည်ဆောက် အစု Wqp  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/aWqkv.bin", 3 * D * D)
    တည်ဆောက် အစု bqp  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/abqkv.bin", 3 * D)
    တည်ဆောက် အစု Wop  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/aWo.bin", D * D)
    တည်ဆောက် အစု bop  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/abo.bin", D)
    တည်ဆောက် အစု dYp  = load_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adY.bin", T * D)

    သုံးသပ်ချက်အရ(Xnp == 0 သို့မဟုတ် Wqp == 0 သို့မဟုတ် bqp == 0 သို့မဟုတ် Wop == 0 သို့မဟုတ် bop == 0 သို့မဟုတ် dYp == 0) {
        ပြန်ပေး 1
    }

    တည်ဆောက် ဒသမ* dWqkv = calloc(3 * D * D, 8)
    တည်ဆောက် ဒသမ* dbqkv = calloc(3 * D, 8)
    တည်ဆောက် ဒသမ* dWo   = calloc(D * D, 8)
    တည်ဆောက် ဒသမ* dbo   = calloc(D, 8)
    တည်ဆောက် ဒသမ* dXn   = calloc(T * D, 8)

    attn_forward_bwd(dWqkv, dbqkv, dWo, dbo, dXn,
                     Xnp, Wqp, bqp, Wop, bop, dYp, T, D, H)

    save_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adWqkv.bin", dWqkv, 3 * D * D)
    save_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adbqkv.bin", dbqkv, 3 * D)
    save_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adWo.bin", dWo, D * D)
    save_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adbo.bin", dbo, D)
    save_f64("/data/data/com.termux/files/home/mmc_publish/ref/bwd_test/adXn.bin", dXn, T * D)

    free(Xnp) free(Wqp) free(bqp) free(Wop) free(bop) free(dYp)
    free(dWqkv) free(dbqkv) free(dWo) free(dbo) free(dXn)

    printf("=== attn backward test DONE ===\n")
    ပြန်ပေး 0
}
