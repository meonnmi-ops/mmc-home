extern "C" အစု malloc(ကိန်း size)
extern "C" void free(အစု ptr)

// hex char → value (0-15), -1 if not hex
လုပ်ငန်း hex_val(ကိန်း c) ကိန်း {
    သုံးသပ်ချက်အရ(c >= 48 နှင့် c <= 57) { ပြန်ပေး c - 48 }
    သုံးသပ်ချက်အရ(c >= 97 နှင့် c <= 102) { ပြန်ပေး c - 87 }
    သုံးသပ်ချက်အရ(c >= 65 နှင့် c <= 70) { ပြန်ပေး c - 55 }
    ပြန်ပေး -1
}

// codepoint → UTF-8 bytes in out (returns count, 0 if invalid)
လုပ်ငန်း cp_put_utf8(ကိန်း cp, စာသား out, ကိန်း dst) ကိန်း {
    သုံးသပ်ချက်အရ(cp < 0 သို့မဟုတ် cp > 1114111) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ(cp < 128) {
        out[dst] = cp
        ပြန်ပေး 1
    }
    သုံးသပ်ချက်အရ(cp < 2048) {
        out[dst] = 192 ♪ (cp ♯ 6)
        out[dst + 1] = 128 ♪ (cp ♩ 63)
        ပြန်ပေး 2
    }
    သုံးသပ်ချက်အရ(cp < 65536) {
        out[dst] = 224 ♪ (cp ♯ 12)
        out[dst + 1] = 128 ♪ ((cp ♯ 6) ♩ 63)
        out[dst + 2] = 128 ♪ (cp ♩ 63)
        ပြန်ပေး 3
    }
    out[dst] = 240 ♪ (cp ♯ 18)
    out[dst + 1] = 128 ♪ ((cp ♯ 12) ♩ 63)
    out[dst + 2] = 128 ♪ ((cp ♯ 6) ♩ 63)
    out[dst + 3] = 128 ♪ (cp ♩ 63)
    ပြန်ပေး 4
}

// "text" field ကို ရှာ + JSON escape decode + out_buf ထဲ ရေး
// ပြန်ပေး = decoded length (bytes), -1 = မ တွေ့, -2 = out_buf မ လုံလောက်
လုပ်ငန်း json_extract_text(အစု line_ptr, ကိန်း len, စာသား out_buf, ကိန်း cap) ကိန်း {
    သုံးသပ်ချက်အရ(line_ptr == 0 သို့မဟုတ် out_buf == 0 သို့မဟုတ် cap < 2) { ပြန်ပေး -2 }
    တည်ဆောက် စာသား s = line_ptr
    တည်ဆောက် ကိန်း i = 0
    // "text" ကို ရှာ
    ပြည့်အောင်(i + 7 < len) {
        သုံးသပ်ချက်အရ(s[i] == 34 နှင့် s[i+1] == 116 နှင့် s[i+2] == 101 နှင့် s[i+3] == 120 နှင့် s[i+4] == 116 နှင့် s[i+5] == 34) {
            တည်ဆောက် ကိန်း j = i + 6
            ပြည့်အောင်(j < len နှင့် s[j] != 58) { j = j + 1 }
            သုံးသပ်ချက်အရ(j >= len) { ပြန်ပေး -1 }
            j = j + 1
            ပြည့်အောင်(j < len နှင့် s[j] != 34) { j = j + 1 }
            သုံးသပ်ချက်အရ(j >= len) { ပြန်ပေး -1 }
            j = j + 1
            // value စ - decode
            တည်ဆောက် ကိန်း dst = 0
            ပြည့်အောင်(j < len နှင့် dst < cap - 8) {
                တည်ဆောက် ကိန်း c = s[j] ♩ 255
                သုံးသပ်ချက်အရ(c == 34) { ရပ် }
                သုံးသပ်ချက်အရ(c == 92) {
                    တည်ဆောက် ကိန်း e = s[j+1] ♩ 255
                    သုံးသပ်ချက်အရ(e == 110) {
                        out_buf[dst] = 10
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 116) {
                        out_buf[dst] = 9
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 114) {
                        out_buf[dst] = 13
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 34) {
                        out_buf[dst] = 34
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 92) {
                        out_buf[dst] = 92
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 47) {
                        out_buf[dst] = 47
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 98) {
                        out_buf[dst] = 8
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 102) {
                        out_buf[dst] = 12
                        dst = dst + 1
                        j = j + 2
                    } မဟုတ်လျှင် သုံးသပ်ချက်အရ(e == 117) {
                        // \uXXXX
                        တည်ဆောက် ကိန်း h1 = hex_val(s[j+2] ♩ 255)
                        တည်ဆောက် ကိန်း h2 = hex_val(s[j+3] ♩ 255)
                        တည်ဆောက် ကိန်း h3 = hex_val(s[j+4] ♩ 255)
                        တည်ဆောက် ကိန်း h4 = hex_val(s[j+5] ♩ 255)
                        သုံးသပ်ချက်အရ(h1 < 0 သို့မဟုတ် h2 < 0 သို့မဟုတ် h3 < 0 သို့မဟုတ် h4 < 0) {
                            ပြန်ပေး -1
                        }
                        တည်ဆောက် ကိန်း cp = h1 * 4096 + h2 * 256 + h3 * 16 + h4
                        တည်ဆောက် ကိန်း nb = cp_put_utf8(cp, out_buf, dst)
                        သုံးသပ်ချက်အရ(nb == 0) { ပြန်ပေး -1 }
                        dst = dst + nb
                        j = j + 6
                    } မဟုတ်လျှင် {
                        // unknown escape → copy raw
                        out_buf[dst] = c
                        dst = dst + 1
                        j = j + 1
                    }
                } မဟုတ်လျှင် {
                    out_buf[dst] = c
                    dst = dst + 1
                    j = j + 1
                }
            }
            out_buf[dst] = 0
            ပြန်ပေး dst
        }
        i = i + 1
    }
    ပြန်ပေး -1
}
