// === External C-links (OS Level) ===
// Only these remain in C because they talk to the OS/Hardware.
extern "C" void* malloc(ကိန်း size)
extern "C" void* realloc(အစု ptr, ကိန်း size)
extern "C" void free(အစု ptr)
extern "C" void printf(စာသား fmt, ...)
extern "C" int puts(စာသား str)
extern "C" char* fgets(စာသား str, ကိန်း size, void* stream)
extern "C" void fwrite(အစု ptr, ကိန်း size, ကိန်း nmemb, void* stream)
extern "C" void fclose(void* stream)
extern "C" void* fopen(စာသား path, စာသား mode)
extern "C" ဒသမ exp(ဒသမ x)

// === MMC Types for Runtime ===
အစုအဝေး MMCArray {
    data void**
    size ကိန်း
    capacity ကိန်း
}

အစုအဝေး MMCMatrix {
    data ဒသမ*
    rows ကိန်း
    cols ကိန်း
}

// ============================================================
// 1. Memory Management (Wrappers)
// ============================================================
လုပ်ငန်း mmc_malloc(ကိန်း size) void* {
    ပြန်ပေး malloc(size)
}

လုပ်ငန်း mmc_realloc(အစု ptr, ကိန်း size) void* {
    ပြန်ပေး realloc(ptr, size)
}

လုပ်ငန်း mmc_free(အစု ptr) {
    free(ptr)
}

// ============================================================
// 2. String Operations (Implemented in MMC)
// ============================================================
လုပ်ငန်း mmc_string_length(စာသား str) ကိန်း {
    တည်ဆောက် ကိန်း len = 0
    ပြည့်အောင်(str[len] != 0) {
        len = len + 1
    }
    ပြန်ပေး len
}

လုပ်ငန်း mmc_string_concat(စာသား a, စာသား b) စာသား {
    တည်ဆောက် ကိန်း len_a = mmc_string_length(a)
    တည်ဆောက် ကိန်း len_b = mmc_string_length(b)
    တည်ဆောက် စာသား res = mmc_malloc(len_a + len_b + 1)
    
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < len_a) {
        res[i] = a[i]
        i = i + 1
    }
    ပြည့်အောင်(i < len_a + len_b) {
        res[i] = b[i - len_a]
        i = i + 1
    }
    res[len_a + len_b] = 0
    ပြန်ပေး res
}

လုပ်ငန်း mmc_string_compare(စာသား a, စာသား b) ကိန်း {
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(a[i] != 0 နှင့် b[i] != 0) {
        သုံးသပ်ချက်အရ(a[i] != b[i]) {
        ပြန်ပေး a[i] - b[i]
    }
        i = i + 1
    }
    ပြန်ပေး a[i] - b[i]
}

လုပ်ငန်း mmc_string_substring(စာသား str, ကိန်း start, ကိန်း end) စာသား {
    တည်ဆောက် ကိန်း len = end - start
    သုံးသပ်ချက်အရ(len <= 0) {
        ပြန်ပေး ""
    }
    တည်ဆောက် စာသား res = mmc_malloc(len + 1)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < len) {
        res[i] = str[start + i]
        i = i + 1
    }
    res[len] = 0
    ပြန်ပေး res
}

လုပ်ငန်း mmc_int_to_string(ကိန်း val) စာသား {
    သုံးသပ်ချက်အရ(val == 0) {
        ပြန်ပေး "0"
    }
    တည်ဆောက် ကိန်း is_neg = 0
    တည်ဆောက် ကိန်း v = val
    သုံးသပ်ချက်အရ(val < 0) {
        is_neg = 1
        v = -val
    }
    
    တည်ဆောက် စာသား res = mmc_malloc(12)
    တည်ဆောက် ကိန်း pos = 0
    ပြည့်အောင်(v > 0) {
        res[pos] = (v % 10) + 48
        v = v / 10
        pos = pos + 1
    }
    
    သုံးသပ်ချက်အရ(is_neg) {
        res[pos] = 45 // '-'
        pos = pos + 1
    }
    res[pos] = 0
    
    // Reverse string
    တည်ဆောက် စာသား rev = mmc_malloc(pos + 1)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < pos) {
        rev[i] = res[pos - 1 - i]
        i = i + 1
    }
    rev[pos] = 0
    mmc_free(res)
    ပြန်ပေး rev
}

လုပ်ငန်း mmc_string_trim(စာသား str) စာသား {
    တည်ဆောက် ကိန်း len = mmc_string_length(str)
    တည်ဆောက် ကိန်း start = 0
    တည်ဆောက် ကိန်း end = len - 1
    
    ပြည့်အောင်(start <= end နှင့် (str[start] == 32 သို့မဟုတ် str[start] == 9 သို့မဟုတ် str[start] == 10)) {
        start = start + 1
    }
    ပြည့်အောင်(end >= start နှင့် (str[end] == 32 သို့မဟုတ် str[end] == 9 သို့မဟုတ် str[end] == 10)) {
        end = end - 1
    }
    
    ပြန်ပေး mmc_string_substring(str, start, end + 1)
}

// ============================================================
// 3. Dynamic Array (Implemented in MMC)
// ============================================================
လုပ်ငန်း mmc_array_new() အစု {
    တည်ဆောက် MMCArray* arr = mmc_malloc(sizeof(MMCArray))
    arr->size = 0
    arr->capacity = 4
    arr->data = mmc_malloc(8 * arr->capacity)
    ပြန်ပေး arr
}

လုပ်ငန်း mmc_array_push(အစု arr_ptr, အစု item) {
    တည်ဆောက် MMCArray* arr = arr_ptr
    သုံးသပ်ချက်အရ(arr->size == arr->capacity) {
        တည်ဆောက် ကိန်း new_cap = arr->capacity * 2
        တည်ဆောက် void* new_data = mmc_realloc(arr->data, 8 * new_cap)
        arr->data = new_data
        arr->capacity = new_cap
    }
    arr->data[arr->size] = item
    arr->size = arr->size + 1
}

လုပ်ငန်း mmc_array_get(အစု arr_ptr, ကိန်း index) void* {
    တည်ဆောက် MMCArray* arr = arr_ptr
    သုံးသပ်ချက်အရ(index < 0 သို့မဟုတ် index >= arr->size) {
        ပြန်ပေး NULL
    }
    ပြန်ပေး arr->data[index]
}

လုပ်ငန်း mmc_array_size(အစု arr_ptr) ကိန်း {
    တည်ဆောက် MMCArray* arr = arr_ptr
    ပြန်ပေး arr->size
}

လုပ်ငန်း mmc_array_free(အစု arr_ptr) {
    တည်ဆောက် MMCArray* arr = arr_ptr
    mmc_free(arr->data)
    mmc_free(arr)
}

// ============================================================
// 4. Matrix Implementation (Implemented in MMC)
// ============================================================
လုပ်ငန်း mmc_matrix_new(ကိန်း rows, ကိန်း cols) အစု {
    တည်ဆောက် MMCMatrix* mat = mmc_malloc(sizeof(MMCMatrix))
    mat->rows = rows
    mat->cols = cols
    mat->data = mmc_malloc(8 * rows * cols)
    ပြန်ပေး mat
}

လုပ်ငန်း mmc_matrix_get(အစု mat_ptr, ကိန်း r, ကိန်း c) ဒသမ {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    ပြန်ပေး mat->data[r * mat->cols + c]
}

လုပ်ငန်း mmc_matrix_set(အစု mat_ptr, ကိန်း r, ကိန်း c, ဒသမ val) {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    mat->data[r * mat->cols + c] = val
}

လုပ်ငန်း mmc_matrix_fill(အစု mat_ptr, ဒသမ val) {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    တည်ဆောက် ကိန်း total = mat->rows * mat->cols
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < total) {
        mat->data[i] = val
        i = i + 1
    }
}

လုပ်ငန်း mmc_matrix_mul(အစု A_ptr, အစု B_ptr) အစု {
    တည်ဆောက် MMCMatrix* A = A_ptr
    တည်ဆောက် MMCMatrix* B = B_ptr
    သုံးသပ်ချက်အရ(A->cols != B->rows) {
        ပြန်ပေး NULL
    }
    
    တည်ဆောက် MMCMatrix* C = mmc_matrix_new(A->rows, B->cols)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < A->rows) {
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < B->cols) {
            တည်ဆောက် ဒသမ sum = 0.0
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < A->cols) {
                sum = sum + mmc_matrix_get(A, i, k) * mmc_matrix_get(B, k, j)
                k = k + 1
            }
            mmc_matrix_set(C, i, j, sum)
            j = j + 1
        }
        i = i + 1
    }
    ပြန်ပေး C
}

လုပ်ငန်း mmc_matrix_add(အစု A_ptr, အစု B_ptr) အစု {
    တည်ဆောက် MMCMatrix* A = A_ptr
    တည်ဆောက် MMCMatrix* B = B_ptr
    သုံးသပ်ချက်အရ(A->rows != B->rows သို့မဟုတ် A->cols != B->cols) {
        ပြန်ပေး NULL
    }
    
    တည်ဆောက် MMCMatrix* C = mmc_matrix_new(A->rows, A->cols)
    တည်ဆောက် ကိန်း i = 0
    တည်ဆောက် ကိန်း total = A->rows * A->cols
    ပြည့်အောင်(i < total) {
        C->data[i] = A->data[i] + B->data[i]
        i = i + 1
    }
    ပြန်ပေး C
}

လုပ်ငန်း mmc_matrix_scale(အစု mat_ptr, ဒသမ s) အစု {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    တည်ဆောက် MMCMatrix* res = mmc_matrix_new(mat->rows, mat->cols)
    တည်ဆောက် ကိန်း i = 0
    တည်ဆောက် ကိန်း total = mat->rows * mat->cols
    ပြည့်အောင်(i < total) {
        res->data[i] = mat->data[i] * s
        i = i + 1
    }
    ပြန်ပေး res
}

လုပ်ငန်း mmc_matrix_softmax(အစု mat_ptr) အစု {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    တည်ဆောက် MMCMatrix* res = mmc_matrix_new(mat->rows, mat->cols)
    
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < mat->rows) {
        တည်ဆောက် ဒသမ max_val = -1000000000
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < mat->cols) {
            သုံးသပ်ချက်အရ(mat->data[i * mat->cols + j] > max_val) {
        max_val = mat->data[i * mat->cols + j]
    }
            j = j + 1
        }
        
        တည်ဆောက် ဒသမ sum = 0.0
        j = 0
        ပြည့်အောင်(j < mat->cols) {
            တည်ဆောက် ဒသမ val = mat->data[i * mat->cols + j] - max_val
            တည်ဆောက် ဒသမ exp_approx = exp(val)
            res->data[i * mat->cols + j] = exp_approx
            sum = sum + exp_approx
            j = j + 1
        }
        
        j = 0
        ပြည့်အောင်(j < mat->cols) {
            res->data[i * mat->cols + j] = res->data[i * mat->cols + j] / sum
            j = j + 1
        }
        i = i + 1
    }
    ပြန်ပေး res
}

လုပ်ငန်း mmc_matrix_free(အစု mat_ptr) {
    တည်ဆောက် MMCMatrix* mat = mat_ptr
    mmc_free(mat->data)
    mmc_free(mat)
}


// ============================================================
// 5. Basic I/O (Implemented in MMC)
// ============================================================
လုပ်ငန်း mmc_println(စာသား str) {
    printf("%s\n", str)
}

လုပ်ငန်း mmc_print(စာသား str) {
    printf("%s", str)
}

လုပ်ငန်း mmc_print_int(ကိန်း val) {
    printf("%d", val)
}

လုပ်ငန်း mmc_print_float(ဒသမ val) {
    printf("%f", val)
}

// ============================================================
// 7. File I/O (Implemented in MMC)
// ============================================================
လုပ်ငန်း mmc_read_file(စာသား filename) စာသား {
    တည်ဆောက် void* fp = fopen(filename, "rb")
    သုံးသပ်ချက်အရ(fp == NULL) {
        ပြန်ပေး NULL
    }
    
    တည်ဆောက် ကိန်း capacity = 1024
    တည်ဆောက် ကိန်း size = 0
    တည်ဆောက် စာသား buffer = mmc_malloc(capacity)
    
    တည်ဆောက် ကိန်း ch
    ပြည့်အောင်(1) {
        // Use fgetc for byte-by-byte reading to ensure full file capture
        extern "C" ကိန်း fgetc(void* stream)
        ch = fgetc(fp)
        သုံးသပ်ချက်အရ(ch == -1) {
        ရပ်
    }
        
        သုံးသပ်ချက်အရ(size + 1 >= capacity) {
            capacity = capacity * 2
            buffer = mmc_realloc(buffer, capacity)
        }
        
        buffer[size] = ch
        size = size + 1
    }
    
    buffer[size] = 0
    fclose(fp)
    ပြန်ပေး buffer
}

လုပ်ငန်း mmc_write_file(စာသား filename, စာသား content) ကိန်း {
    တည်ဆောက် void* fp = fopen(filename, "w")
    သုံးသပ်ချက်အရ(fp == NULL) {
        ပြန်ပေး 0
    }
    
    တည်ဆောက် ကိန်း len = mmc_string_length(content)
    fwrite(content, 1, len, fp)
    
    fclose(fp)
    ပြန်ပေး 1
}

// ═══════════════════════════════════════
// 7. Trigram (n-gram) — ML functions
// ═══════════════════════════════════════
extern "C" ကိန်း rand()
extern "C" void srand(ကိန်း seed)
extern "C" void putchar(ကိန်း c)

တည်ဆောက် ကိန်း g_trigram[16777216]

လုပ်ငန်း mmc_trigram_clear() ကိန်း {
    တည်ဆောက် ကိန်း k = 0
    ပြည့်အောင်(k < 16777216) {
        g_trigram[k] = 0
        k = k + 1
    }
    ပြန်ပေး 0
}

လုပ်ငန်း mmc_trigram_train(စာသား text) ကိန်း {
    mmc_trigram_clear()
    တည်ဆောက် ကိန်း len = mmc_string_length(text)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < len - 2) {
        တည်ဆောက် ကိန်း c1 = text[i] ♩ 255
        တည်ဆောက် ကိန်း c2 = text[i + 1] ♩ 255
        တည်ဆောက် ကိန်း c3 = text[i + 2] ♩ 255
        တည်ဆောက် ကိန်း idx = c1 * 65536 + c2 * 256 + c3
        g_trigram[idx] = g_trigram[idx] + 1
        i = i + 1
    }
    ပြန်ပေး len
}

လုပ်ငန်း mmc_trigram_generate(စာသား seed, ကိန်း max_len) ကိန်း {
    srand(42)
    တည်ဆောက် ကိန်း slen = mmc_string_length(seed)
    သုံးသပ်ချက်အရ(slen < 2) {
        ပြန်ပေး -1
    }
    တည်ဆောက် ကိန်း c1 = seed[slen - 2] ♩ 255
    တည်ဆောက် ကိန်း c2 = seed[slen - 1] ♩ 255
    mmc_print(seed)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < max_len) {
        တည်ဆောက် ကိန်း base = c1 * 65536 + c2 * 256
        တည်ဆောက် ကိန်း total = 0
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < 256) {
            total = total + g_trigram[base + j]
            j = j + 1
        }
        သုံးသပ်ချက်အရ(total == 0) {
            ရပ်
        }
        တည်ဆောက် ကိန်း r = rand() % total
        တည်ဆောက် ကိန်း cum = 0
        တည်ဆောက် ကိန်း c3 = 0
        j = 0
        ပြည့်အောင်(j < 256) {
            cum = cum + g_trigram[base + j]
            သုံးသပ်ချက်အရ(cum > r) {
                c3 = j
                ရပ်
            }
            j = j + 1
        }
        putchar(c3)
        c1 = c2
        c2 = c3
        i = i + 1
    }
    mmc_println("")
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 8. Fgram (5-gram hash) — ML functions
// ═══════════════════════════════════════
တည်ဆောက် ကိန်း g_fg_ctx0[65536]
တည်ဆောက် ကိန်း g_fg_ctx1[65536]
တည်ဆောက် ကိန်း g_fg_ctx2[65536]
တည်ဆောက် ကိန်း g_fg_ctx3[65536]
တည်ဆောက် ကိန်း g_fg_next[65536]
တည်ဆောက် ကိန်း g_fg_count[65536]

လုပ်ငန်း fg_hash4(ကိန်း a, ကိန်း b, ကိန်း c, ကိန်း d) ကိန်း {
    တည်ဆောက် ကိန်း h = a * 73856093 ♫ b * 19349663 ♫ c * 83492791 ♫ d * 2654435761
    ပြန်ပေး h % 65536
}

လုပ်ငန်း mmc_fgram_clear() ကိန်း {
    တည်ဆောက် ကိန်း k = 0
    ပြည့်အောင်(k < 65536) {
        g_fg_ctx0[k] = 0
        g_fg_ctx1[k] = 0
        g_fg_ctx2[k] = 0
        g_fg_ctx3[k] = 0
        g_fg_next[k] = 0
        g_fg_count[k] = 0
        k = k + 1
    }
    ပြန်ပေး 0
}

လုပ်ငန်း mmc_fgram_train(စာသား text) ကိန်း {
    mmc_fgram_clear()
    တည်ဆောက် ကိန်း len = mmc_string_length(text)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < len - 4) {
        တည်ဆောက် ကိန်း c0 = text[i] ♩ 255
        တည်ဆောက် ကိန်း c1 = text[i + 1] ♩ 255
        တည်ဆောက် ကိန်း c2 = text[i + 2] ♩ 255
        တည်ဆောက် ကိန်း c3 = text[i + 3] ♩ 255
        တည်ဆောက် ကိန်း nc = text[i + 4] ♩ 255
        တည်ဆောက် ကိန်း h = fg_hash4(c0, c1, c2, c3)
        တည်ဆောက် ကိန်း found = 0
        ပြည့်အောင်(g_fg_count[h] > 0) {
            သုံးသပ်ချက်အရ(g_fg_ctx0[h] == c0 နှင့် g_fg_ctx1[h] == c1 နှင့် g_fg_ctx2[h] == c2 နှင့် g_fg_ctx3[h] == c3 နှင့် g_fg_next[h] == nc) {
                g_fg_count[h] = g_fg_count[h] + 1
                found = 1
                ရပ်
            }
            h = (h + 1) % 65536
        }
        သုံးသပ်ချက်အရ(found == 0) {
            g_fg_ctx0[h] = c0
            g_fg_ctx1[h] = c1
            g_fg_ctx2[h] = c2
            g_fg_ctx3[h] = c3
            g_fg_next[h] = nc
            g_fg_count[h] = 1
        }
        i = i + 1
    }
    ပြန်ပေး len
}

လုပ်ငန်း mmc_fgram_generate(စာသား seed, ကိန်း max_len) ကိန်း {
    srand(42)
    တည်ဆောက် ကိန်း slen = mmc_string_length(seed)
    သုံးသပ်ချက်အရ(slen < 4) {
        ပြန်ပေး -1
    }
    တည်ဆောက် ကိန်း ctx0 = seed[slen - 4] ♩ 255
    တည်ဆောက် ကိန်း ctx1 = seed[slen - 3] ♩ 255
    တည်ဆောက် ကိန်း ctx2 = seed[slen - 2] ♩ 255
    တည်ဆောက် ကိန်း ctx3 = seed[slen - 1] ♩ 255
    mmc_print(seed)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < max_len) {
        တည်ဆောက် ကိန်း h = fg_hash4(ctx0, ctx1, ctx2, ctx3)
        တည်ဆောက် ကိန်း start = h
        တည်ဆောက် ကိန်း total = 0
        ပြည့်အောင်(g_fg_count[h] > 0) {
            သုံးသပ်ချက်အရ(g_fg_ctx0[h] == ctx0 နှင့် g_fg_ctx1[h] == ctx1 နှင့် g_fg_ctx2[h] == ctx2 နှင့် g_fg_ctx3[h] == ctx3) {
                total = total + g_fg_count[h]
            }
            h = (h + 1) % 65536
            သုံးသပ်ချက်အရ(h == start) {
                ရပ်
            }
        }
        သုံးသပ်ချက်အရ(total == 0) {
            ရပ်
        }
        တည်ဆောက် ကိန်း r = rand() % total
        တည်ဆောက် ကိန်း cum = 0
        တည်ဆောက် ကိန်း nxt = 0
        h = start
        ပြည့်အောင်(g_fg_count[h] > 0) {
            သုံးသပ်ချက်အရ(g_fg_ctx0[h] == ctx0 နှင့် g_fg_ctx1[h] == ctx1 နှင့် g_fg_ctx2[h] == ctx2 နှင့် g_fg_ctx3[h] == ctx3) {
                cum = cum + g_fg_count[h]
                သုံးသပ်ချက်အရ(cum > r) {
                    nxt = g_fg_next[h]
                    ရပ်
                }
            }
            h = (h + 1) % 65536
            သုံးသပ်ချက်အရ(h == start) {
                ရပ်
            }
        }
        သုံးသပ်ချက်အရ(nxt == 0) {
            ရပ်
        }
        putchar(nxt)
        ctx0 = ctx1
        ctx1 = ctx2
        ctx2 = ctx3
        ctx3 = nxt
        i = i + 1
    }
    mmc_println("")
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 9. Word-level Markov — ML functions
// ═══════════════════════════════════════
တည်ဆောက် ကိန်း g_word_chars[640000]
တည်ဆောက် ကိန်း g_word_start[10000]
တည်ဆောက် ကိန်း g_word_len[10000]
တည်ဆောက် ကိန်း g_wm_n = 0

တည်ဆောက် ကိန်း g_wm_next_ids[640000]
တည်ဆောက် ကိန်း g_wm_next_counts[640000]
တည်ဆောက် ကိန်း g_wm_next_n[10000]
တည်ဆောက် ကိန်း g_wm_total[10000]

လုပ်ငန်း wm_find_or_insert(ကိန်း src_start, ကိန်း src_len, စာသား text) ကိန်း {
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < g_wm_n) {
        သုံးသပ်ချက်အရ(g_word_len[i] == src_len) {
            တည်ဆောက် ကိန်း j = 0
            တည်ဆောက် ကိန်း match = 1
            ပြည့်အောင်(j < src_len) {
                သုံးသပ်ချက်အရ(g_word_chars[g_word_start[i] + j] != (text[src_start + j] ♩ 255)) {
                    match = 0
                    ရပ်
                }
                j = j + 1
            }
            သုံးသပ်ချက်အရ(match == 1) {
                ပြန်ပေး i
            }
        }
        i = i + 1
    }
    သုံးသပ်ချက်အရ(g_wm_n >= 10000) {
        ပြန်ပေး -1
    }
    တည်ဆောက် ကိန်း new_id = g_wm_n
    တည်ဆောက် ကိန်း cstart = new_id * 64
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < src_len နှင့် j < 63) {
        g_word_chars[cstart + j] = text[src_start + j] ♩ 255
        j = j + 1
    }
    g_word_chars[cstart + j] = 0
    g_word_start[new_id] = cstart
    g_word_len[new_id] = j
    g_wm_n = g_wm_n + 1
    ပြန်ပေး new_id
}

လုပ်ငန်း mmc_word_clear() ကိန်း {
    g_wm_n = 0
    တည်ဆောက် ကိန်း k = 0
    ပြည့်အောင်(k < 10000) {
        g_wm_next_n[k] = 0
        g_wm_total[k] = 0
        k = k + 1
    }
    ပြန်ပေး 0
}

လုပ်ငန်း mmc_word_train(စာသား text) ကိန်း {
    mmc_word_clear()
    တည်ဆောက် ကိန်း tlen = mmc_string_length(text)
    တည်ဆောက် ကိန်း i = 0
    တည်ဆောက် ကိန်း cur_start = -1
    တည်ဆောက် ကိန်း prev_id = -1
    ပြည့်အောင်(i <= tlen) {
        တည်ဆောက် ကိန်း is_space = 1
        သုံးသပ်ချက်အရ(i < tlen) {
            သုံးသပ်ချက်အရ(text[i] != 32) {
                is_space = 0
            }
        }
        သုံးသပ်ချက်အရ(is_space == 0) {
            သုံးသပ်ချက်အရ(cur_start < 0) {
                cur_start = i
            }
        } မဟုတ်လျှင် {
            သုံးသပ်ချက်အရ(cur_start >= 0) {
                တည်ဆောက် ကိန်း wlen = i - cur_start
                တည်ဆောက် ကိန်း wid = wm_find_or_insert(cur_start, wlen, text)
                သုံးသပ်ချက်အရ(wid >= 0 နှင့် prev_id >= 0) {
                    တည်ဆောက် ကိန်း j = 0
                    တည်ဆောက် ကိန်း found = 0
                    ပြည့်အောင်(j < g_wm_next_n[prev_id]) {
                        သုံးသပ်ချက်အရ(g_wm_next_ids[prev_id * 64 + j] == wid) {
                            g_wm_next_counts[prev_id * 64 + j] = g_wm_next_counts[prev_id * 64 + j] + 1
                            g_wm_total[prev_id] = g_wm_total[prev_id] + 1
                            found = 1
                            ရပ်
                        }
                        j = j + 1
                    }
                    သုံးသပ်ချက်အရ(found == 0 နှင့် g_wm_next_n[prev_id] < 64) {
                        တည်ဆောက် ကိန်း idx = prev_id * 64 + g_wm_next_n[prev_id]
                        g_wm_next_ids[idx] = wid
                        g_wm_next_counts[idx] = 1
                        g_wm_next_n[prev_id] = g_wm_next_n[prev_id] + 1
                        g_wm_total[prev_id] = g_wm_total[prev_id] + 1
                    }
                }
                prev_id = wid
                cur_start = -1
            }
        }
        i = i + 1
    }
    ပြန်ပေး g_wm_n
}

လုပ်ငန်း mmc_word_generate(စာသား seed_word, ကိန်း max_words) ကိန်း {
    တည်ဆောက် ကိန်း slen = mmc_string_length(seed_word)
    တည်ဆောက် ကိန်း cur_id = -1
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < g_wm_n) {
        သုံးသပ်ချက်အရ(g_word_len[i] == slen) {
            တည်ဆောက် ကိန်း j = 0
            တည်ဆောက် ကိန်း match = 1
            ပြည့်အောင်(j < slen) {
                သုံးသပ်ချက်အရ(g_word_chars[g_word_start[i] + j] != (seed_word[j] ♩ 255)) {
                    match = 0
                    ရပ်
                }
                j = j + 1
            }
            သုံးသပ်ချက်အရ(match == 1) {
                cur_id = i
                ရပ်
            }
        }
        i = i + 1
    }
    သုံးသပ်ချက်အရ(cur_id < 0) {
        mmc_println("Seed not found")
        ပြန်ပေး -1
    }
    srand(42)
    mmc_print(seed_word)
    တည်ဆောက် ကိန်း n = 0
    ပြည့်အောင်(n < max_words) {
        သုံးသပ်ချက်အရ(g_wm_total[cur_id] == 0) {
            ရပ်
        }
        တည်ဆောက် ကိန်း r = rand() % g_wm_total[cur_id]
        တည်ဆောက် ကိန်း cum = 0
        တည်ဆောက် ကိန်း chosen = -1
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < g_wm_next_n[cur_id]) {
            cum = cum + g_wm_next_counts[cur_id * 64 + j]
            သုံးသပ်ချက်အရ(cum > r) {
                chosen = g_wm_next_ids[cur_id * 64 + j]
                ရပ်
            }
            j = j + 1
        }
        သုံးသပ်ချက်အရ(chosen < 0) {
            ရပ်
        }
        cur_id = chosen
        mmc_print(" ")
        တည်ဆောက် ကိန်း wlen = g_word_len[cur_id]
        တည်ဆောက် ကိန်း wstart = g_word_start[cur_id]
        တည်ဆောက် ကိန်း wj = 0
        ပြည့်အောင်(wj < wlen) {
            putchar(g_word_chars[wstart + wj])
            wj = wj + 1
        }
        n = n + 1
    }
    mmc_println("")
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 10. UTF-8 Decoder + Myanmar Trigram
// ═══════════════════════════════════════
လုပ်ငန်း utf8_decode(စာသား s, ကိန်း pos, ကိန်း len) ကိန်း {
    သုံးသပ်ချက်အရ(pos >= len) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း b1 = s[pos] ♩ 255
    သုံးသပ်ချက်အရ(b1 < 128) { ပြန်ပေး b1 }
    သုံးသပ်ချက်အရ(b1 < 224) {
        သုံးသပ်ချက်အရ(pos + 1 >= len) { ပြန်ပေး 0 }
        တည်ဆောက် ကိန်း b2 = s[pos + 1] ♩ 255
        ပြန်ပေး ((b1 ♩ 31) ♭ 6) ♪ (b2 ♩ 63)
    }
    သုံးသပ်ချက်အရ(b1 < 240) {
        သုံးသပ်ချက်အရ(pos + 2 >= len) { ပြန်ပေး 0 }
        တည်ဆောက် ကိန်း c2 = s[pos + 1] ♩ 255
        တည်ဆောက် ကိန်း c3 = s[pos + 2] ♩ 255
        ပြန်ပေး ((b1 ♩ 15) ♭ 12) ♪ ((c2 ♩ 63) ♭ 6) ♪ (c3 ♩ 63)
    }
    ပြန်ပေး 0
}

လုပ်ငန်း utf8_charlen(စာသား s, ကိန်း pos) ကိန်း {
    တည်ဆောက် ကိန်း b1 = s[pos] ♩ 255
    သုံးသပ်ချက်အရ(b1 < 128) { ပြန်ပေး 1 }
    သုံးသပ်ချက်အရ(b1 < 224) { ပြန်ပေး 2 }
    သုံးသပ်ချက်အရ(b1 < 240) { ပြန်ပေး 3 }
    ပြန်ပေး 4
}

လုပ်ငန်း utf8_encode_putc(ကိန်း cp) ကိန်း {
    သုံးသပ်ချက်အရ(cp < 128) {
        putchar(cp)
        ပြန်ပေး 1
    }
    သုံးသပ်ချက်အရ(cp < 2048) {
        putchar(192 ♪ (cp ♯ 6))
        putchar(128 ♪ (cp ♩ 63))
        ပြန်ပေး 2
    }
    သုံးသပ်ချက်အရ(cp < 65536) {
        putchar(224 ♪ (cp ♯ 12))
        putchar(128 ♪ ((cp ♯ 6) ♩ 63))
        putchar(128 ♪ (cp ♩ 63))
        ပြန်ပေး 3
    }
    ပြန်ပေး 0
}

တည်ဆောက် ကိန်း g_my_c1[65536]
တည်ဆောက် ကိန်း g_my_c2[65536]
တည်ဆောက် ကိန်း g_my_c3[65536]
တည်ဆောက် ကိန်း g_my_next[65536]
တည်ဆောက် ကိန်း g_my_count[65536]

လုပ်ငန်း my_hash2(ကိန်း a, ကိန်း b) ကိန်း {
    တည်ဆောက် ကိန်း h = a * 31337 ♫ b * 10007
    ပြန်ပေး h % 65536
}

လုပ်ငန်း my_hash3(ကိန်း a, ကိန်း b, ကိန်း c) ကိန်း {
    တည်ဆောက် ကိန်း h = a * 31337 ♫ b * 10007 ♫ c * 7919
    ပြန်ပေး h % 65536
}

လုပ်ငန်း mmc_mytrigram_clear() ကိန်း {
    တည်ဆောက် ကိန်း k = 0
    ပြည့်အောင်(k < 65536) {
        g_my_c1[k] = 0
        g_my_c2[k] = 0
        g_my_c3[k] = 0
        g_my_next[k] = 0
        g_my_count[k] = 0
        k = k + 1
    }
    ပြန်ပေး 0
}

လုပ်ငန်း mmc_mytrigram_train(စာသား text) ကိန်း {
    mmc_mytrigram_clear()
    တည်ဆောက် ကိန်း tlen = mmc_string_length(text)
    တည်ဆောက် ကိန်း cp1 = 0
    တည်ဆောက် ကိန်း cp2 = 0
    တည်ဆောက် ကိန်း state = 0
    တည်ဆောက် ကိန်း pos = 0
    တည်ဆောက် ကိန်း count = 0
    ပြည့်အောင်(pos < tlen) {
        တည်ဆောက် ကိန်း clen = utf8_charlen(text, pos)
        တည်ဆောက် ကိန်း cp = utf8_decode(text, pos, tlen)
        သုံးသပ်ချက်အရ(cp > 0) {
            သုံးသပ်ချက်အရ(state == 0) {
                cp1 = cp
                state = 1
            } မဟုတ်လျှင် သုံးသပ်ချက်အရ(state == 1) {
                cp2 = cp
                state = 2
            } မဟုတ်လျှင် {
                တည်ဆောက် ကိန်း h = my_hash2(cp1, cp2)
                တည်ဆောက် ကိန်း found = 0
                ပြည့်အောင်(g_my_count[h] > 0) {
                    သုံးသပ်ချက်အရ(g_my_c1[h] == cp1 နှင့် g_my_c2[h] == cp2 နှင့် g_my_c3[h] == cp) {
                        g_my_count[h] = g_my_count[h] + 1
                        found = 1
                        ရပ်
                    }
                    h = (h + 1) % 65536
                }
                သုံးသပ်ချက်အရ(found == 0) {
                    g_my_c1[h] = cp1
                    g_my_c2[h] = cp2
                    g_my_c3[h] = cp
                    g_my_next[h] = cp
                    g_my_count[h] = 1
                }
                count = count + 1
                cp1 = cp2
                cp2 = cp
            }
        }
        pos = pos + clen
    }
    ပြန်ပေး count
}

လုပ်ငန်း mmc_mytrigram_generate(စာသား seed, ကိန်း max_chars) ကိန်း {
    srand(42)
    တည်ဆောက် ကိန်း slen = mmc_string_length(seed)
    တည်ဆောက် ကိန်း cps[100]
    တည်ဆောက် ကိန်း ncp = 0
    တည်ဆောက် ကိန်း pos = 0
    ပြည့်အောင်(pos < slen နှင့် ncp < 100) {
        တည်ဆောက် ကိန်း clen = utf8_charlen(seed, pos)
        တည်ဆောက် ကိန်း cp = utf8_decode(seed, pos, slen)
        သုံးသပ်ချက်အရ(cp > 0) {
            cps[ncp] = cp
            ncp = ncp + 1
        }
        pos = pos + clen
    }
    သုံးသပ်ချက်အရ(ncp < 2) { ပြန်ပေး -1 }
    တည်ဆောက် ကိန်း ctx1 = cps[ncp - 2]
    တည်ဆောက် ကိန်း ctx2 = cps[ncp - 1]
    mmc_print(seed)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < max_chars) {
        တည်ဆောက် ကိန်း h = my_hash2(ctx1, ctx2)
        တည်ဆောက် ကိန်း start = h
        တည်ဆောက် ကိန်း total = 0
        ပြည့်အောင်(g_my_count[h] > 0) {
            သုံးသပ်ချက်အရ(g_my_c1[h] == ctx1 နှင့် g_my_c2[h] == ctx2) {
                total = total + g_my_count[h]
            }
            h = (h + 1) % 65536
            သုံးသပ်ချက်အရ(h == start) { ရပ် }
        }
        သုံးသပ်ချက်အရ(total == 0) { ရပ် }
        တည်ဆောက် ကိန်း r = rand() % total
        တည်ဆောက် ကိန်း cum = 0
        တည်ဆောက် ကိန်း nxt_cp = 0
        h = start
        ပြည့်အောင်(g_my_count[h] > 0) {
            သုံးသပ်ချက်အရ(g_my_c1[h] == ctx1 နှင့် g_my_c2[h] == ctx2) {
                cum = cum + g_my_count[h]
                သုံးသပ်ချက်အရ(cum > r) {
                    nxt_cp = g_my_next[h]
                    ရပ်
                }
            }
            h = (h + 1) % 65536
            သုံးသပ်ချက်အရ(h == start) { ရပ် }
        }
        သုံးသပ်ချက်အရ(nxt_cp == 0) { ရပ် }
        utf8_encode_putc(nxt_cp)
        ctx1 = ctx2
        ctx2 = nxt_cp
        i = i + 1
    }
    mmc_println("")
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 11. LayerNorm + GELU (Transformer blocks)
// ═══════════════════════════════════════
extern "C" ဒသမ sqrt(ဒသမ x)
extern "C" ဒသမ tanh(ဒသမ x)

// LayerNorm: y = (x - mean) / sqrt(var + eps) * gamma + beta
// In-place: modifies x in place
လုပ်ငန်း mmc_layer_norm(အစု x_ptr, ကိန်း n, ဒသမ eps, အစု gamma_ptr, အစု beta_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(n <= 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* x = x_ptr
    တည်ဆောက် ဒသမ* g = gamma_ptr
    တည်ဆောက် ဒသမ* b = beta_ptr
    တည်ဆောက် ဒသမ sum = 0.0
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < n) {
        sum = sum + x[i]
        i = i + 1
    }
    တည်ဆောက် ဒသမ mean = sum / n
    တည်ဆောက် ဒသမ var = 0.0
    i = 0
    ပြည့်အောင်(i < n) {
        တည်ဆောက် ဒသမ d = x[i] - mean
        var = var + d * d
        i = i + 1
    }
    var = var / n
    တည်ဆောက် ဒသမ inv_std = 1.0 / sqrt(var + eps)
    i = 0
    ပြည့်အောင်(i < n) {
        x[i] = (x[i] - mean) * inv_std * g[i] + b[i]
        i = i + 1
    }
    ပြန်ပေး 0
}

// GELU (tanh approximation): 0.5*x*(1+tanh(√(2/π)·(x+0.044715·x³)))
လုပ်ငန်း mmc_gelu(ဒသမ x) ဒသမ {
    တည်ဆောက် ဒသမ c = 0.7978845608
    တည်ဆောက် ဒသမ x2 = x * x
    တည်ဆောက် ဒသမ x3 = x2 * x
    တည်ဆောက် ဒသမ inner = c * (x + 0.044715 * x3)
    ပြန်ပေး 0.5 * x * (1.0 + tanh(inner))
}

// GELU element-wise (in-place)
လုပ်ငန်း mmc_gelu_vec(အစု x_ptr, ကိန်း n) ကိန်း {
    သုံးသပ်ချက်အရ(n <= 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* x = x_ptr
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < n) {
        x[i] = mmc_gelu(x[i])
        i = i + 1
    }
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 12. Single-head Attention
// ═══════════════════════════════════════
// Q, K, V: [seq_len, d] matrices
// out = softmax(Q·K^T / √d) · V
// Returns: new matrix [seq_len, d]

လုပ်ငန်း mmc_attention_single(အစု Q_ptr, အစု K_ptr, အစု V_ptr, ကိန်း seq_len, ကိန်း d) အစု {
    သုံးသပ်ချက်အရ(seq_len <= 0 သို့မဟုတ် d <= 0) {
        ပြန်ပေး 0
    }
    တည်ဆောက် MMCMatrix* Q = Q_ptr
    တည်ဆောက် MMCMatrix* K = K_ptr
    တည်ဆောက် MMCMatrix* V = V_ptr
    
    // 1. scores = Q·K^T / √d
    တည်ဆောက် အစု scores_ptr = mmc_matrix_new(seq_len, seq_len)
    သုံးသပ်ချက်အရ(scores_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* scores = scores_ptr
    တည်ဆောက် ဒသမ scale = 1.0 / sqrt(d * 1.0)
    
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < seq_len) {
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < seq_len) {
            တည်ဆောက် ဒသမ dot = 0.0
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < d) {
                dot = dot + Q->data[i * d + k] * K->data[j * d + k]
                k = k + 1
            }
            scores->data[i * seq_len + j] = dot * scale
            j = j + 1
        }
        i = i + 1
    }
    
    // 2. softmax over rows (returns new matrix, not in-place)
    တည်ဆောက် အစု softmaxed_ptr = mmc_matrix_softmax(scores_ptr)
    mmc_matrix_free(scores_ptr)
    သုံးသပ်ချက်အရ(softmaxed_ptr == 0) {
        ပြန်ပေး 0
    }
    scores_ptr = softmaxed_ptr
    scores = softmaxed_ptr
    
    // 3. out = scores · V
    တည်ဆောက် အစု out_ptr = mmc_matrix_new(seq_len, d)
    သုံးသပ်ချက်အရ(out_ptr == 0) {
        mmc_matrix_free(scores_ptr)
        ပြန်ပေး 0
    }
    တည်ဆောက် MMCMatrix* out = out_ptr
    
    i = 0
    ပြည့်အောင်(i < seq_len) {
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < d) {
            တည်ဆောက် ဒသမ sum = 0.0
            တည်ဆောက် ကိန်း j = 0
            ပြည့်အောင်(j < seq_len) {
                sum = sum + scores->data[i * seq_len + j] * V->data[j * d + k]
                j = j + 1
            }
            out->data[i * d + k] = sum
            k = k + 1
        }
        i = i + 1
    }
    
    mmc_matrix_free(scores_ptr)
    ပြန်ပေး out_ptr
}

// ═══════════════════════════════════════
// 13. Linear + FFN + Transformer Block
// ═══════════════════════════════════════

// Linear: out[i][j] = sum_k x[i][k] * W[k][j] + b[j]
// x: [seq_len, d_in], W: [d_in, d_out], b: double[d_out]
လုပ်ငန်း mmc_linear(အစု x_ptr, အစု W_ptr, အစု b_ptr) အစု {
    တည်ဆောက် MMCMatrix* x = x_ptr
    တည်ဆောက် MMCMatrix* W = W_ptr
    သုံးသပ်ချက်အရ(x == 0 သို့မဟုတ် W == 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း seq_len = x->rows
    တည်ဆောက် ကိန်း d_in = x->cols
    တည်ဆောက် ကိန်း d_out = W->cols
    သုံးသပ်ချက်အရ(W->rows != d_in) { ပြန်ပေး 0 }
    တည်ဆောက် အစု out_ptr = mmc_matrix_new(seq_len, d_out)
    သုံးသပ်ချက်အရ(out_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* out = out_ptr
    တည်ဆောက် ဒသမ* b = 0
    သုံးသပ်ချက်အရ(b_ptr != 0) { b = b_ptr }
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < seq_len) {
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < d_out) {
            တည်ဆောက် ဒသမ sum = 0.0
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < d_in) {
                sum = sum + x->data[i * d_in + k] * W->data[k * d_out + j]
                k = k + 1
            }
            သုံးသပ်ချက်အရ(b != 0) { sum = sum + b[j] }
            out->data[i * d_out + j] = sum
            j = j + 1
        }
        i = i + 1
    }
    ပြန်ပေး out_ptr
}

// Add matrix in place: target += other
လုပ်ငန်း mmc_matrix_add_inplace(အစု target_ptr, အစု other_ptr) ကိန်း {
    တည်ဆောက် MMCMatrix* t = target_ptr
    တည်ဆောက် MMCMatrix* o = other_ptr
    သုံးသပ်ချက်အရ(t == 0 သို့မဟုတ် o == 0) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ(t->rows != o->rows သို့မဟုတ် t->cols != o->cols) { ပြန်ပေး -2 }
    တည်ဆောက် ကိန်း total = t->rows * t->cols
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < total) {
        t->data[i] = t->data[i] + o->data[i]
        i = i + 1
    }
    ပြန်ပေး 0
}

// Copy matrix (new allocation)
လုပ်ငန်း mmc_matrix_copy(အစု src_ptr) အစု {
    တည်ဆောက် MMCMatrix* s = src_ptr
    သုံးသပ်ချက်အရ(s == 0) { ပြန်ပေး 0 }
    တည်ဆောက် အစု dst_ptr = mmc_matrix_new(s->rows, s->cols)
    သုံးသပ်ချက်အရ(dst_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* d = dst_ptr
    တည်ဆောက် ကိန်း total = s->rows * s->cols
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < total) {
        d->data[i] = s->data[i]
        i = i + 1
    }
    ပြန်ပေး dst_ptr
}

// FFN: h = GELU(x@W1 + b1), out = h@W2 + b2
လုပ်ငန်း mmc_ffn(အစု x_ptr, အစု W1_ptr, အစု b1_ptr, အစု W2_ptr, အစု b2_ptr) အစု {
    တည်ဆောက် အစု h_ptr = mmc_linear(x_ptr, W1_ptr, b1_ptr)
    သုံးသပ်ချက်အရ(h_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* h = h_ptr
    mmc_gelu_vec(h->data, h->rows * h->cols)
    တည်ဆောက် အစု out_ptr = mmc_linear(h_ptr, W2_ptr, b2_ptr)
    mmc_matrix_free(h_ptr)
    ပြန်ပေး out_ptr
}

// Transformer block (pre-norm, single head self-attention)
လုပ်ငန်း mmc_transformer_block(အစု x_ptr,
    အစု Wq_ptr, အစု bq_ptr, အစု Wk_ptr, အစု bk_ptr,
    အစု Wv_ptr, အစု bv_ptr, အစု Wo_ptr, အစု bo_ptr,
    အစု ln1_g_ptr, အစု ln1_b_ptr,
    အစု W1_ptr, အစု b1_ptr, အစု W2_ptr, အစု b2_ptr,
    အစု ln2_g_ptr, အစု ln2_b_ptr) အစု {

    တည်ဆောက် MMCMatrix* x = x_ptr
    သုံးသပ်ချက်အရ(x == 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း seq_len = x->rows
    တည်ဆောက် ကိန်း d = x->cols

    // ── Attention (pre-norm) ──
    တည်ဆောက် အစု normed_ptr = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(normed_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* normed = normed_ptr
    mmc_layer_norm(normed->data, seq_len * d, 0.00001, ln1_g_ptr, ln1_b_ptr)

    တည်ဆောက် အစု Q_ptr = mmc_linear(normed_ptr, Wq_ptr, bq_ptr)
    တည်ဆောက် အစု K_ptr = mmc_linear(normed_ptr, Wk_ptr, bk_ptr)
    တည်ဆောက် အစု V_ptr = mmc_linear(normed_ptr, Wv_ptr, bv_ptr)
    mmc_matrix_free(normed_ptr)
    သုံးသပ်ချက်အရ(Q_ptr == 0 သို့မဟုတ် K_ptr == 0 သို့မဟုတ် V_ptr == 0) {
        သုံးသပ်ချက်အရ(Q_ptr != 0) { mmc_matrix_free(Q_ptr) }
        သုံးသပ်ချက်အရ(K_ptr != 0) { mmc_matrix_free(K_ptr) }
        သုံးသပ်ချက်အရ(V_ptr != 0) { mmc_matrix_free(V_ptr) }
        ပြန်ပေး 0
    }

    တည်ဆောက် အစု attn_ptr = mmc_attention_single(Q_ptr, K_ptr, V_ptr, seq_len, d)
    mmc_matrix_free(Q_ptr)
    mmc_matrix_free(K_ptr)
    mmc_matrix_free(V_ptr)
    သုံးသပ်ချက်အရ(attn_ptr == 0) { ပြန်ပေး 0 }

    တည်ဆောက် အစု proj_ptr = mmc_linear(attn_ptr, Wo_ptr, bo_ptr)
    mmc_matrix_free(attn_ptr)
    သုံးသပ်ချက်အရ(proj_ptr == 0) { ပြန်ပေး 0 }

    // Residual 1
    တည်ဆောက် အစု x1_ptr = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(x1_ptr == 0) {
        mmc_matrix_free(proj_ptr)
        ပြန်ပေး 0
    }
    mmc_matrix_add_inplace(x1_ptr, proj_ptr)
    mmc_matrix_free(proj_ptr)

    // ── FFN (pre-norm) ──
    တည်ဆောက် အစု normed2_ptr = mmc_matrix_copy(x1_ptr)
    သုံးသပ်ချက်အရ(normed2_ptr == 0) {
        mmc_matrix_free(x1_ptr)
        ပြန်ပေး 0
    }
    တည်ဆောက် MMCMatrix* normed2 = normed2_ptr
    mmc_layer_norm(normed2->data, seq_len * d, 0.00001, ln2_g_ptr, ln2_b_ptr)

    တည်ဆောက် အစု ffn_ptr = mmc_ffn(normed2_ptr, W1_ptr, b1_ptr, W2_ptr, b2_ptr)
    mmc_matrix_free(normed2_ptr)
    သုံးသပ်ချက်အရ(ffn_ptr == 0) {
        mmc_matrix_free(x1_ptr)
        ပြန်ပေး 0
    }

    // Residual 2
    mmc_matrix_add_inplace(x1_ptr, ffn_ptr)
    mmc_matrix_free(ffn_ptr)

    ပြန်ပေး x1_ptr
}

// ═══════════════════════════════════════
// 14. N-Block Stack (multi-layer transformer)
// ═══════════════════════════════════════

// Block weights bundle (16 pointers = 128 bytes)
အစုအဝေး MMCBlockWeights {
    Wq အစု
    bq အစု
    Wk အစု
    bk အစု
    Wv အစု
    bv အစု
    Wo အစု
    bo အစု
    ln1g အစု
    ln1b အစု
    W1 အစု
    b1 အစု
    W2 အစု
    b2 အစု
    ln2g အစု
    ln2b အစု
}

// Allocate + fill one block's weights (16 void* = 128 bytes)
လုပ်ငန်း mmc_block_weights_new(အစု Wq, အစု bq, အစု Wk, အစု bk,
    အစု Wv, အစု bv, အစု Wo, အစု bo,
    အစု ln1g, အစု ln1b, အစု W1, အစု b1, အစု W2, အစု b2,
    အစု ln2g, အစု ln2b) အစု {
    တည်ဆောက် MMCBlockWeights* bw = mmc_malloc(128)
    သုံးသပ်ချက်အရ(bw == 0) { ပြန်ပေး 0 }
    bw->Wq = Wq
    bw->bq = bq
    bw->Wk = Wk
    bw->bk = bk
    bw->Wv = Wv
    bw->bv = bv
    bw->Wo = Wo
    bw->bo = bo
    bw->ln1g = ln1g
    bw->ln1b = ln1b
    bw->W1 = W1
    bw->b1 = b1
    bw->W2 = W2
    bw->b2 = b2
    bw->ln2g = ln2g
    bw->ln2b = ln2b
    ပြန်ပေး bw
}

// Forward through N blocks. Input x NOT freed. Returns NEW matrix.
လုပ်ငန်း mmc_transformer_forward(အစု x_ptr, အစု blocks_arr_ptr, ကိန်း n_blocks) အစု {
    သုံးသပ်ချက်အရ(x_ptr == 0) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ(n_blocks <= 0) {
        ပြန်ပေး mmc_matrix_copy(x_ptr)
    }
    တည်ဆောက် အစု current = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(current == 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < n_blocks) {
        တည်ဆောက် MMCBlockWeights* bw = mmc_array_get(blocks_arr_ptr, i)
        သုံးသပ်ချက်အရ(bw == 0) { ပြန်ပေး current }
        တည်ဆောက် အစု next = mmc_transformer_block(current,
            bw->Wq, bw->bq, bw->Wk, bw->bk, bw->Wv, bw->bv, bw->Wo, bw->bo,
            bw->ln1g, bw->ln1b, bw->W1, bw->b1, bw->W2, bw->b2,
            bw->ln2g, bw->ln2b)
        သုံးသပ်ချက်အရ(next == 0) { ပြန်ပေး current }
        mmc_matrix_free(current)
        current = next
        i = i + 1
    }
    ပြန်ပေး current
}

// ═══════════════════════════════════════
// 15. Multi-Head Attention
// ═══════════════════════════════════════
// Q, K, V: [seq_len, d] where d = n_heads * head_dim
// Split d into n_heads, run attention per head, concat, return [seq_len, d]

လုပ်ငန်း mmc_attention_multi(အစု Q_ptr, အစု K_ptr, အစု V_ptr, ကိန်း seq_len, ကိန်း d, ကိန်း n_heads) အစု {
    သုံးသပ်ချက်အရ(seq_len <= 0 သို့မဟုတ် d <= 0 သို့မဟုတ် n_heads <= 0) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ(d % n_heads != 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း head_dim = d / n_heads
    တည်ဆောက် MMCMatrix* Q = Q_ptr
    တည်ဆောက် MMCMatrix* K = K_ptr
    တည်ဆောက် MMCMatrix* V = V_ptr
    သုံးသပ်ချက်အရ(Q == 0 သို့မဟုတ် K == 0 သို့မဟုတ် V == 0) { ပြန်ပေး 0 }

    // Allocate output [seq_len, d]
    တည်ဆောက် အစု out_ptr = mmc_matrix_new(seq_len, d)
    သုံးသပ်ချက်အရ(out_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* out = out_ptr

    // Per-head: extract Q_h, K_h, V_h → attention_single → write into out
    တည်ဆောက် ကိန်း h = 0
    ပြည့်အောင်(h < n_heads) {
        တည်ဆောက် အစု Qh_ptr = mmc_matrix_new(seq_len, head_dim)
        တည်ဆောက် အစု Kh_ptr = mmc_matrix_new(seq_len, head_dim)
        တည်ဆောက် အစု Vh_ptr = mmc_matrix_new(seq_len, head_dim)
        သုံးသပ်ချက်အရ(Qh_ptr == 0 သို့မဟုတ် Kh_ptr == 0 သို့မဟုတ် Vh_ptr == 0) {
            သုံးသပ်ချက်အရ(Qh_ptr != 0) { mmc_matrix_free(Qh_ptr) }
            သုံးသပ်ချက်အရ(Kh_ptr != 0) { mmc_matrix_free(Kh_ptr) }
            သုံးသပ်ချက်အရ(Vh_ptr != 0) { mmc_matrix_free(Vh_ptr) }
            mmc_matrix_free(out_ptr)
            ပြန်ပေး 0
        }
        တည်ဆောက် MMCMatrix* Qh = Qh_ptr
        တည်ဆောက် MMCMatrix* Kh = Kh_ptr
        တည်ဆောက် MMCMatrix* Vh = Vh_ptr

        // Extract per-head slice
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < seq_len) {
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < head_dim) {
                Qh->data[i * head_dim + k] = Q->data[i * d + h * head_dim + k]
                Kh->data[i * head_dim + k] = K->data[i * d + h * head_dim + k]
                Vh->data[i * head_dim + k] = V->data[i * d + h * head_dim + k]
                k = k + 1
            }
            i = i + 1
        }

        // Attention per head
        တည်ဆောက် အစု attn_h_ptr = mmc_attention_single(Qh_ptr, Kh_ptr, Vh_ptr, seq_len, head_dim)
        mmc_matrix_free(Qh_ptr)
        mmc_matrix_free(Kh_ptr)
        mmc_matrix_free(Vh_ptr)
        သုံးသပ်ချက်အရ(attn_h_ptr == 0) {
            mmc_matrix_free(out_ptr)
            ပြန်ပေး 0
        }
        တည်ဆောက် MMCMatrix* attn_h = attn_h_ptr

        // Write back to output slice
        i = 0
        ပြည့်အောင်(i < seq_len) {
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < head_dim) {
                out->data[i * d + h * head_dim + k] = attn_h->data[i * head_dim + k]
                k = k + 1
            }
            i = i + 1
        }
        mmc_matrix_free(attn_h_ptr)
        h = h + 1
    }

    ပြန်ပေး out_ptr
}

// ═══════════════════════════════════════
// 16. Multi-Head Transformer Block + Stack
// ═══════════════════════════════════════

// Multi-head transformer block (same as mmc_transformer_block but uses attention_multi)
လုပ်ငန်း mmc_transformer_block_mh(အစု x_ptr,
    အစု Wq_ptr, အစု bq_ptr, အစု Wk_ptr, အစု bk_ptr,
    အစု Wv_ptr, အစု bv_ptr, အစု Wo_ptr, အစု bo_ptr,
    အစု ln1_g_ptr, အစု ln1_b_ptr,
    အစု W1_ptr, အစု b1_ptr, အစု W2_ptr, အစု b2_ptr,
    အစု ln2_g_ptr, အစု ln2_b_ptr,
    ကိန်း n_heads) အစု {

    တည်ဆောက် MMCMatrix* x = x_ptr
    သုံးသပ်ချက်အရ(x == 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း seq_len = x->rows
    တည်ဆောက် ကိန်း d = x->cols

    // ── Attention (pre-norm) ──
    တည်ဆောက် အစု normed_ptr = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(normed_ptr == 0) { ပြန်ပေး 0 }
    တည်ဆောက် MMCMatrix* normed = normed_ptr
    mmc_layer_norm(normed->data, seq_len * d, 0.00001, ln1_g_ptr, ln1_b_ptr)

    တည်ဆောက် အစု Q_ptr = mmc_linear(normed_ptr, Wq_ptr, bq_ptr)
    တည်ဆောက် အစု K_ptr = mmc_linear(normed_ptr, Wk_ptr, bk_ptr)
    တည်ဆောက် အစု V_ptr = mmc_linear(normed_ptr, Wv_ptr, bv_ptr)
    mmc_matrix_free(normed_ptr)
    သုံးသပ်ချက်အရ(Q_ptr == 0 သို့မဟုတ် K_ptr == 0 သို့မဟုတ် V_ptr == 0) {
        သုံးသပ်ချက်အရ(Q_ptr != 0) { mmc_matrix_free(Q_ptr) }
        သုံးသပ်ချက်အရ(K_ptr != 0) { mmc_matrix_free(K_ptr) }
        သုံးသပ်ချက်အရ(V_ptr != 0) { mmc_matrix_free(V_ptr) }
        ပြန်ပေး 0
    }

    တည်ဆောက် အစု attn_ptr = mmc_attention_multi(Q_ptr, K_ptr, V_ptr, seq_len, d, n_heads)
    mmc_matrix_free(Q_ptr)
    mmc_matrix_free(K_ptr)
    mmc_matrix_free(V_ptr)
    သုံးသပ်ချက်အရ(attn_ptr == 0) { ပြန်ပေး 0 }

    တည်ဆောက် အစု proj_ptr = mmc_linear(attn_ptr, Wo_ptr, bo_ptr)
    mmc_matrix_free(attn_ptr)
    သုံးသပ်ချက်အရ(proj_ptr == 0) { ပြန်ပေး 0 }

    // Residual 1
    တည်ဆောက် အစု x1_ptr = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(x1_ptr == 0) {
        mmc_matrix_free(proj_ptr)
        ပြန်ပေး 0
    }
    mmc_matrix_add_inplace(x1_ptr, proj_ptr)
    mmc_matrix_free(proj_ptr)

    // ── FFN (pre-norm) ──
    တည်ဆောက် အစု normed2_ptr = mmc_matrix_copy(x1_ptr)
    သုံးသပ်ချက်အရ(normed2_ptr == 0) {
        mmc_matrix_free(x1_ptr)
        ပြန်ပေး 0
    }
    တည်ဆောက် MMCMatrix* normed2 = normed2_ptr
    mmc_layer_norm(normed2->data, seq_len * d, 0.00001, ln2_g_ptr, ln2_b_ptr)

    တည်ဆောက် အစု ffn_ptr = mmc_ffn(normed2_ptr, W1_ptr, b1_ptr, W2_ptr, b2_ptr)
    mmc_matrix_free(normed2_ptr)
    သုံးသပ်ချက်အရ(ffn_ptr == 0) {
        mmc_matrix_free(x1_ptr)
        ပြန်ပေး 0
    }

    // Residual 2
    mmc_matrix_add_inplace(x1_ptr, ffn_ptr)
    mmc_matrix_free(ffn_ptr)

    ပြန်ပေး x1_ptr
}

// Multi-head stack forward (all blocks share same n_heads)
လုပ်ငန်း mmc_transformer_forward_mh(အစု x_ptr, အစု blocks_arr_ptr, ကိန်း n_blocks, ကိန်း n_heads) အစု {
    သုံးသပ်ချက်အရ(x_ptr == 0) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ(n_blocks <= 0) {
        ပြန်ပေး mmc_matrix_copy(x_ptr)
    }
    တည်ဆောက် အစု current = mmc_matrix_copy(x_ptr)
    သုံးသပ်ချက်အရ(current == 0) { ပြန်ပေး 0 }
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < n_blocks) {
        တည်ဆောက် MMCBlockWeights* bw = mmc_array_get(blocks_arr_ptr, i)
        သုံးသပ်ချက်အရ(bw == 0) { ပြန်ပေး current }
        တည်ဆောက် အစု next = mmc_transformer_block_mh(current,
            bw->Wq, bw->bq, bw->Wk, bw->bk, bw->Wv, bw->bv, bw->Wo, bw->bo,
            bw->ln1g, bw->ln1b, bw->W1, bw->b1, bw->W2, bw->b2,
            bw->ln2g, bw->ln2b, n_heads)
        သုံးသပ်ချက်အရ(next == 0) { ပြန်ပေး current }
        mmc_matrix_free(current)
        current = next
        i = i + 1
    }
    ပြန်ပေး current
}

// ═══════════════════════════════════════
// 17. GGUF Header Parser (buffer-only)
// ═══════════════════════════════════════
// Caller loads file → passes (buf, size).
// Results stored in globals.

တည်ဆောက် ကိန်း g_gguf_version = 0
တည်ဆောက် ကိန်း g_gguf_tensor_count = 0
တည်ဆောက် ကိန်း g_gguf_kv_count = 0

// Parse GGUF header. Returns 0 = ok, -1 = bad.
လုပ်ငန်း mmc_gguf_parse_header(အစု buf, ကိန်း size) ကိန်း {
    g_gguf_version = 0
    g_gguf_tensor_count = 0
    g_gguf_kv_count = 0
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် size < 24) { ပြန်ပေး -1 }
    တည်ဆောက် စာသား p = buf
    သုံးသပ်ချက်အရ((p[0] ♩ 255) != 71) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ((p[1] ♩ 255) != 71) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ((p[2] ♩ 255) != 85) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ((p[3] ♩ 255) != 70) { ပြန်ပေး -1 }
    // version at offset 4 (u32 LE)
    g_gguf_version = (p[4] ♩ 255) ♪ ((p[5] ♩ 255) ♭ 8) ♪ ((p[6] ♩ 255) ♭ 16) ♪ ((p[7] ♩ 255) ♭ 24)
    // tensor_count at offset 8 (u64 LE, low 32)
    g_gguf_tensor_count = (p[8] ♩ 255) ♪ ((p[9] ♩ 255) ♭ 8) ♪ ((p[10] ♩ 255) ♭ 16) ♪ ((p[11] ♩ 255) ♭ 24)
    // kv_count at offset 16 (u64 LE, low 32)
    g_gguf_kv_count = (p[16] ♩ 255) ♪ ((p[17] ♩ 255) ♭ 8) ♪ ((p[18] ♩ 255) ♭ 16) ♪ ((p[19] ♩ 255) ♭ 24)
    ပြန်ပေး 0
}

လုပ်ငန်း gguf_get_version() ကိန်း { ပြန်ပေး g_gguf_version }
လုပ်ငန်း gguf_get_tensor_count() ကိန်း { ပြန်ပေး g_gguf_tensor_count }
လုပ်ငန်း gguf_get_kv_count() ကိန်း { ပြန်ပေး g_gguf_kv_count }

// ═══════════════════════════════════════
// 18. GGUF Tensor Info Parser
// ═══════════════════════════════════════
// Parse KV (24) by type, then 293 tensor infos.

တည်ဆောက် ကိန်း g_gguf_size = 0
တည်ဆောက် ကိန်း g_t_count = 0
တည်ဆောက် ကိန်း g_t_data_start = 0

တည်ဆောက် ကိန်း g_t_name_off[300]
တည်ဆောက် ကိန်း g_t_name_len[300]
တည်ဆောက် ကိန်း g_t_n_dims[300]
တည်ဆောက် ကိန်း g_t_dims[1200]
တည်ဆောက် ကိန်း g_t_type[300]
တည်ဆောက် ကိန်း g_t_offset[300]

လုပ်ငန်း gguf_check_magic(အစု buf) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် g_gguf_size < 24) { ပြန်ပေး 0 }
    တည်ဆောက် စာသား p = buf
    သုံးသပ်ချက်အရ((p[0] ♩ 255) != 71) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ((p[1] ♩ 255) != 71) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ((p[2] ♩ 255) != 85) { ပြန်ပေး 0 }
    သုံးသပ်ချက်အရ((p[3] ♩ 255) != 70) { ပြန်ပေး 0 }
    ပြန်ပေး 1
}


လုပ်ငန်း gguf_read_u32(အစု buf, ကိန်း pos) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် pos < 0 သို့မဟုတ် pos + 4 > g_gguf_size) { ပြန်ပေး -1 }
    တည်ဆောက် စာသား p = buf
    ပြန်ပေး (p[pos] ♩ 255) ♪ ((p[pos+1] ♩ 255) ♭ 8) ♪ ((p[pos+2] ♩ 255) ♭ 16) ♪ ((p[pos+3] ♩ 255) ♭ 24)
}

လုပ်ငန်း gguf_read_u64_lo(အစု buf, ကိန်း pos) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် pos < 0 သို့မဟုတ် pos + 8 > g_gguf_size) { ပြန်ပေး -1 }
    ပြန်ပေး gguf_read_u32(buf, pos)
}

// Skip one GGUF value. Returns new pos, -1 on error.
လုပ်ငန်း gguf_skip_value(အစု buf, ကိန်း pos, ကိန်း vtype) ကိန်း {
    သုံးသပ်ချက်အရ(vtype == 0 သို့မဟုတ် vtype == 1 သို့မဟုတ် vtype == 7) { ပြန်ပေး pos + 1 }
    သုံးသပ်ချက်အရ(vtype == 2 သို့မဟုတ် vtype == 3) { ပြန်ပေး pos + 2 }
    သုံးသပ်ချက်အရ(vtype == 4 သို့မဟုတ် vtype == 5 သို့မဟုတ် vtype == 6) { ပြန်ပေး pos + 4 }
    သုံးသပ်ချက်အရ(vtype == 8) {
        တည်ဆောက် ကိန်း n = gguf_read_u64_lo(buf, pos)
        သုံးသပ်ချက်အရ(n < 0) { ပြန်ပေး -1 }
        ပြန်ပေး pos + 8 + n
    }
    သုံးသပ်ချက်အရ(vtype == 9) {
        တည်ဆောက် ကိန်း etype = gguf_read_u32(buf, pos)
        တည်ဆောက် ကိန်း cnt = gguf_read_u64_lo(buf, pos + 4)
        သုံးသပ်ချက်အရ(etype < 0 သို့မဟုတ် cnt < 0) { ပြန်ပေး -1 }
        pos = pos + 12
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < cnt) {
            pos = gguf_skip_value(buf, pos, etype)
            သုံးသပ်ချက်အရ(pos < 0) { ပြန်ပေး -1 }
            i = i + 1
        }
        ပြန်ပေး pos
    }
    သုံးသပ်ချက်အရ(vtype == 10 သို့မဟုတ် vtype == 11 သို့မဟုတ် vtype == 12) { ပြန်ပေး pos + 8 }
    ပြန်ပေး -1
}

လုပ်ငန်း gguf_skip_kv(အစု buf, ကိန်း pos, ကိန်း count) ကိန်း {
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < count) {
        တည်ဆောက် ကိန်း klen = gguf_read_u64_lo(buf, pos)
        သုံးသပ်ချက်အရ(klen < 0 သို့မဟုတ် klen > 500) { ပြန်ပေး -1 }
        pos = pos + 8 + klen
        တည်ဆောက် ကိန်း vtype = gguf_read_u32(buf, pos)
        သုံးသပ်ချက်အရ(vtype < 0) { ပြန်ပေး -1 }
        pos = pos + 4
        pos = gguf_skip_value(buf, pos, vtype)
        သုံးသပ်ချက်အရ(pos < 0) { ပြန်ပေး -1 }
        i = i + 1
    }
    ပြန်ပေး pos
}

လုပ်ငန်း mmc_gguf_parse_tensors(အစု buf, ကိန်း size) ကိန်း {
    g_gguf_size = size
    g_t_count = 0
    g_t_data_start = 0
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် size < 24) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ(gguf_check_magic(buf) == 0) { ပြန်ပေး -2 }
    တည်ဆောက် ကိန်း tcount = gguf_read_u64_lo(buf, 8)
    တည်ဆောက် ကိန်း kcount = gguf_read_u64_lo(buf, 16)
    သုံးသပ်ချက်အရ(tcount < 0 သို့မဟုတ် tcount > 300) { ပြန်ပေး -3 }
    သုံးသပ်ချက်အရ(kcount < 0 သို့မဟုတ် kcount > 100) { ပြန်ပေး -4 }
    g_t_count = tcount
    တည်ဆောက် ကိန်း pos = 24
    pos = gguf_skip_kv(buf, pos, kcount)
    သုံးသပ်ချက်အရ(pos < 0) { ပြန်ပေး -5 }
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < tcount) {
        တည်ဆောက် ကိန်း nlen = gguf_read_u64_lo(buf, pos)
        သုံးသပ်ချက်အရ(nlen < 0 သို့မဟုတ် nlen > 200) { ပြန်ပေး -6 }
        pos = pos + 8
        g_t_name_off[i] = pos
        g_t_name_len[i] = nlen
        pos = pos + nlen
        တည်ဆောက် ကိန်း nd = gguf_read_u32(buf, pos)
        သုံးသပ်ချက်အရ(nd < 0 သို့မဟုတ် nd > 4) { ပြန်ပေး -7 }
        pos = pos + 4
        g_t_n_dims[i] = nd
        တည်ဆောက် ကိန်း d = 0
        ပြည့်အောင်(d < nd) {
            g_t_dims[i * 4 + d] = gguf_read_u64_lo(buf, pos)
            pos = pos + 8
            d = d + 1
        }
        g_t_type[i] = gguf_read_u32(buf, pos)
        pos = pos + 4
        g_t_offset[i] = gguf_read_u64_lo(buf, pos)
        pos = pos + 8
        i = i + 1
    }
    // GGUF: align to 32-byte boundary before tensor data
    တည်ဆောက် ကိန်း pad = (32 - (pos % 32)) % 32
    g_t_data_start = pos + pad
    ပြန်ပေး 0
}

လုပ်ငန်း gguf_tensor_count_final() ကိန်း { ပြန်ပေး g_t_count }
လုပ်ငန်း gguf_tensor_name_off(ကိန်း i) ကိန်း { ပြန်ပေး g_t_name_off[i] }
လုပ်ငန်း gguf_tensor_name_len(ကိန်း i) ကိန်း { ပြန်ပေး g_t_name_len[i] }
လုပ်ငန်း gguf_tensor_n_dims(ကိန်း i) ကိန်း { ပြန်ပေး g_t_n_dims[i] }
လုပ်ငန်း gguf_tensor_dim(ကိန်း i, ကိန်း d) ကိန်း { ပြန်ပေး g_t_dims[i * 4 + d] }
လုပ်ငန်း gguf_tensor_type(ကိန်း i) ကိန်း { ပြန်ပေး g_t_type[i] }
လုပ်ငန်း gguf_tensor_offset(ကိန်း i) ကိန်း { ပြန်ပေး g_t_offset[i] }
လုပ်ငန်း gguf_data_start() ကိန်း { ပြန်ပေး g_t_data_start }

// ═══════════════════════════════════════
// 19. GGUF Dequantization (f16/f32/Q4_0)
// ═══════════════════════════════════════

// 2^n for n in [-150, 130]
လုပ်ငန်း mmc_pow2(ကိန်း n) ဒသမ {
    တည်ဆောက် ဒသမ r = 1.0
    တည်ဆောက် ကိန်း e = n
    သုံးသပ်ချက်အရ(e < 0) {
        e = 0 - e
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < e) {
            r = r / 2.0
            i = i + 1
        }
    } မဟုတ်လျှင် {
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < e) {
            r = r * 2.0
            i = i + 1
        }
    }
    ပြန်ပေး r
}

// FP16 (uint16 bits) → double
လုပ်ငန်း mmc_f16_to_f64(ကိန်း h) ဒသမ {
    တည်ဆောက် ကိန်း sign = (h ♯ 15) ♩ 1
    တည်ဆောက် ကိန်း exp  = (h ♯ 10) ♩ 31
    တည်ဆောက် ကိန်း mant = h ♩ 1023
    တည်ဆောက် ဒသမ sm = 1.0
    သုံးသပ်ချက်အရ(sign == 1) { sm = 0.0 - 1.0 }
    သုံးသပ်ချက်အရ(exp == 0) {
        သုံးသပ်ချက်အရ(mant == 0) { ပြန်ပေး 0.0 }
        တည်ဆောက် ဒသမ md = mant
        ပြန်ပေး sm * md / 16777216.0
    }
    သုံးသပ်ချက်အရ(exp == 31) { ပြန်ပေး 0.0 }
    တည်ဆောက် ဒသမ md = mant
    တည်ဆောက် ဒသမ norm = 1.0 + md / 1024.0
    ပြန်ပေး sm * norm * mmc_pow2(exp - 15)
}

// Read little-endian FP16 at (buf + data_start + off) → double
လုပ်ငန်း mmc_f16_at(အစု buf, ကိန်း ds, ကိန်း off) ဒသမ {
    သုံးသပ်ချက်အရ(buf == 0) { ပြန်ပေး 0.0 }
    တည်ဆောက် စာသား p = buf
    တည်ဆောက် ကိန်း base = ds + off
    သုံးသပ်ချက်အရ(base + 2 > g_gguf_size) { ပြန်ပေး 0.0 }
    တည်ဆောက် ကိန်း b0 = p[base] ♩ 255
    တည်ဆောက် ကိန်း b1 = p[base + 1] ♩ 255
    ပြန်ပေး mmc_f16_to_f64(b0 ♪ (b1 ♭ 8))
}

// Read little-endian FP32 at (buf + ds + off) → double
လုပ်ငန်း mmc_f32_at(အစု buf, ကိန်း ds, ကိန်း off) ဒသမ {
    သုံးသပ်ချက်အရ(buf == 0) { ပြန်ပေး 0.0 }
    တည်ဆောက် စာသား p = buf
    တည်ဆောက် ကိန်း base = ds + off
    သုံးသပ်ချက်အရ(base + 4 > g_gguf_size) { ပြန်ပေး 0.0 }
    တည်ဆောက် ကိန်း b0 = p[base] ♩ 255
    တည်ဆောက် ကိန်း b1 = p[base + 1] ♩ 255
    တည်ဆောက် ကိန်း b2 = p[base + 2] ♩ 255
    တည်ဆောက် ကိန်း b3 = p[base + 3] ♩ 255
    တည်ဆောက် ကိန်း sign = (b3 ♯ 7) ♩ 1
    တည်ဆောက် ကိန်း exp = ((b3 ♩ 127) ♭ 1) ♪ ((b2 ♯ 7) ♩ 1)
    တည်ဆောက် ကိန်း mant = ((b2 ♩ 127) ♭ 16) ♪ (b1 ♭ 8) ♪ b0
    တည်ဆောက် ဒသမ sm = 1.0
    သုံးသပ်ချက်အရ(sign == 1) { sm = 0.0 - 1.0 }
    သုံးသပ်ချက်အရ(exp == 0) {
        သုံးသပ်ချက်အရ(mant == 0) { ပြန်ပေး 0.0 }
        တည်ဆောက် ဒသမ md = mant
        ပြန်ပေး sm * (md / 8388608.0) * mmc_pow2(-126)
    }
    သုံးသပ်ချက်အရ(exp == 255) { ပြန်ပေး 0.0 }
    တည်ဆောက် ဒသမ md = mant
    တည်ဆောက် ဒသမ norm = 1.0 + md / 8388608.0
    ပြန်ပေး sm * norm * mmc_pow2(exp - 127)
}

// Q4_0 block: 32 doubles from 18 bytes (2B fp16 scale + 16B nibbles)
လုပ်ငန်း mmc_q4_0_block(အစု buf, ကိန်း ds, ကိန်း off, အစု out_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    တည်ဆောက် စာသား p = buf
    တည်ဆောက် ကိန်း base = ds + off
    သုံးသပ်ချက်အရ(base + 18 > g_gguf_size) { ပြန်ပေး -2 }
    တည်ဆောက် ကိန်း hb0 = p[base] ♩ 255
    တည်ဆောက် ကိန်း hb1 = p[base + 1] ♩ 255
    တည်ဆောက် ဒသမ d = mmc_f16_to_f64(hb0 ♪ (hb1 ♭ 8))
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < 16) {
        တည်ဆောက် ကိန်း qb = p[base + 2 + j] ♩ 255
        တည်ဆောက် ကိန်း lo = (qb ♩ 15) - 8
        တည်ဆောက် ကိန်း hi = (qb ♯ 4) - 8
        out[j] = lo * d
        out[j + 16] = hi * d
        j = j + 1
    }
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 20. Tensor Row Readers
// ═══════════════════════════════════════

// Read full row from Q4_0 tensor. row_size must be multiple of 32.
လုပ်ငန်း mmc_q4_0_row(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း row, ကိန်း row_size, အစု out_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ(row_size % 32 != 0) { ပြန်ပေး -2 }
    တည်ဆောက် ကိန်း nblocks = row_size / 32
    တည်ဆောက် ကိန်း row_bytes = nblocks * 18
    တည်ဆောက် ကိန်း row_start = t_off + row * row_bytes
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ကိန်း b = 0
    ပြည့်အောင်(b < nblocks) {
        တည်ဆောက် ကိန်း rc = mmc_q4_0_block(buf, ds, row_start + b * 18, out + b * 32)
        သုံးသပ်ချက်အရ(rc != 0) { ပြန်ပေး rc }
        b = b + 1
    }
    ပြန်ပေး 0
}

// Read full row from F32 tensor
လုပ်ငန်း mmc_f32_row(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း row, ကိန်း row_size, အစု out_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ကိန်း row_bytes = row_size * 4
    တည်ဆောက် ကိန်း row_start = t_off + row * row_bytes
    တည်ဆောက် ကိန်း c = 0
    ပြည့်အောင်(c < row_size) {
        out[c] = mmc_f32_at(buf, ds, row_start + c * 4)
        c = c + 1
    }
    ပြန်ပေး 0
}

// Read full row from F16 tensor
လုပ်ငန်း mmc_f16_row(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း row, ကိန်း row_size, အစု out_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ကိန်း row_bytes = row_size * 2
    တည်ဆောက် ကိန်း row_start = t_off + row * row_bytes
    တည်ဆောက် ကိန်း c = 0
    ပြည့်အောင်(c < row_size) {
        out[c] = mmc_f16_at(buf, ds, row_start + c * 2)
        c = c + 1
    }
    ပြန်ပေး 0
}

// ═══════════════════════════════════════
// 21. Linear Layer (Q4_0 / F32 / F16)
// ═══════════════════════════════════════
// y[rows] = W[rows, cols] @ x[cols] + b[rows]
// W is row-major; each row = cols values.
// Caller must pass row_buffer of cols doubles (avoids malloc per call).

// Q4_0 linear. row_buffer is temp workspace (cols doubles).
လုပ်ငန်း mmc_linear_q4_0(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း rows, ကိန်း cols,
                          အစု x_ptr, အစု b_ptr, အစု out_ptr, အစု row_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် x_ptr == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    သုံးသပ်ချက်အရ(cols % 32 != 0) { ပြန်ပေး -2 }
    တည်ဆောက် ဒသမ* x = x_ptr
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ဒသမ* row = row_ptr
    သုံးသပ်ချက်အရ(row == 0) { ပြန်ပေး -3 }
    တည်ဆောက် ကိန်း nblocks = cols / 32
    တည်ဆောက် ကိန်း row_bytes = nblocks * 18
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < rows) {
        တည်ဆောက် ကိန်း rc = mmc_q4_0_row(buf, ds, t_off, j, cols, row)
        သုံးသပ်ချက်အရ(rc != 0) { ပြန်ပေး rc }
        တည်ဆောက် ဒသမ sum = 0.0
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < cols) {
            sum = sum + row[k] * x[k]
            k = k + 1
        }
        သုံးသပ်ချက်အရ(b_ptr != 0) {
            တည်ဆောက် ဒသမ* b = b_ptr
            sum = sum + b[j]
        }
        out[j] = sum
        j = j + 1
    }
    ပြန်ပေး 0
}

// F32 linear
လုပ်ငန်း mmc_linear_f32(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း rows, ကိန်း cols,
                         အစု x_ptr, အစု b_ptr, အစု out_ptr, အစု row_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် x_ptr == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* x = x_ptr
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ဒသမ* row = row_ptr
    သုံးသပ်ချက်အရ(row == 0) { ပြန်ပေး -3 }
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < rows) {
        တည်ဆောက် ကိန်း rc = mmc_f32_row(buf, ds, t_off, j, cols, row)
        သုံးသပ်ချက်အရ(rc != 0) { ပြန်ပေး rc }
        တည်ဆောက် ဒသမ sum = 0.0
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < cols) {
            sum = sum + row[k] * x[k]
            k = k + 1
        }
        သုံးသပ်ချက်အရ(b_ptr != 0) {
            တည်ဆောက် ဒသမ* b = b_ptr
            sum = sum + b[j]
        }
        out[j] = sum
        j = j + 1
    }
    ပြန်ပေး 0
}

// F16 linear
လုပ်ငန်း mmc_linear_f16(အစု buf, ကိန်း ds, ကိန်း t_off, ကိန်း rows, ကိန်း cols,
                         အစု x_ptr, အစု b_ptr, အစု out_ptr, အစု row_ptr) ကိန်း {
    သုံးသပ်ချက်အရ(buf == 0 သို့မဟုတ် x_ptr == 0 သို့မဟုတ် out_ptr == 0) { ပြန်ပေး -1 }
    တည်ဆောက် ဒသမ* x = x_ptr
    တည်ဆောက် ဒသမ* out = out_ptr
    တည်ဆောက် ဒသမ* row = row_ptr
    သုံးသပ်ချက်အရ(row == 0) { ပြန်ပေး -3 }
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < rows) {
        တည်ဆောက် ကိန်း rc = mmc_f16_row(buf, ds, t_off, j, cols, row)
        သုံးသပ်ချက်အရ(rc != 0) { ပြန်ပေး rc }
        တည်ဆောက် ဒသမ sum = 0.0
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < cols) {
            sum = sum + row[k] * x[k]
            k = k + 1
        }
        သုံးသပ်ချက်အရ(b_ptr != 0) {
            တည်ဆောက် ဒသမ* b = b_ptr
            sum = sum + b[j]
        }
        out[j] = sum
        j = j + 1
    }
    ပြန်ပေး 0
}
