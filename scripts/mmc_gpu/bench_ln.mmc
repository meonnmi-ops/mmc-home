ကမ္ဘာလုံး လုပ်ငန်း ln_fwd_row(ဒသမ* x, ဒသမ* g, ဒသမ* b, ဒသမ* y, ကိန်း D, ဒသမ eps) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း base = row * D
    တည်ဆောက် ဒသမ sum = 0
    တည်ဆောက် ကိန်း k = 0
    ပြည့်အောင်(k < D) {
        sum = sum + x[base + k]
        k = k + 1
    }
    တည်ဆောက် ဒသမ mean = sum / D
    တည်ဆောက် ဒသမ var = 0
    တည်ဆောက် ကိန်း k2 = 0
    ပြည့်အောင်(k2 < D) {
        တည်ဆောက် ဒသမ d = x[base + k2] - mean
        var = var + d * d
        k2 = k2 + 1
    }
    var = var / D
    တည်ဆောက် ဒသမ rstd = 1.0 / sqrt(var + eps)
    တည်ဆောက် ကိန်း k3 = 0
    ပြည့်အောင်(k3 < D) {
        y[base + k3] = (x[base + k3] - mean) * rstd * g[k3] + b[k3]
        k3 = k3 + 1
    }
}
လုပ်ငန်း main() {
    တည်ဆောက် ကိန်း M = 50000
    တည်ဆောက် ကိန်း D = 256
    တည်ဆောက် ကိန်း xbytes = 102400000
    တည်ဆောက် ဒသမ* hx = mmc_malloc(xbytes)
    တည်ဆောက် ဒသမ* hy = mmc_malloc(xbytes)
    တည်ဆောက် ဒသမ* hyc = mmc_malloc(xbytes)
    တည်ဆောက် ဒသမ* hg = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hb = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* dx = mmc_gpu_malloc(xbytes)
    တည်ဆောက် ဒသမ* dy = mmc_gpu_malloc(xbytes)
    တည်ဆောက် ဒသမ* dg = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* db = mmc_gpu_malloc(2048)
    တည်ဆောက် ကိန်း i = 0
    ပြည့်အောင်(i < D) {
        hg[i] = 0.5
        hb[i] = 0.25
        i = i + 1
    }
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < M * D) {
        hx[j] = j * 0.0000001 - 1.28
        j = j + 1
    }
    mmc_gpu_copy_to(dx, hx, xbytes)
    mmc_gpu_copy_to(dg, hg, 2048)
    mmc_gpu_copy_to(db, hb, 2048)
    တည်ဆောက် ဒသမ t0 = mmc_now_ms()
    mmc_gpu_launch_ln(ln_fwd_row, dx, dg, db, dy, D, 0.000001, M)
    cudaDeviceSynchronize()
    တည်ဆောက် ဒသမ t1 = mmc_now_ms()
    mmc_gpu_copy_from(hy, dy, xbytes)
    printf("LN GPU: M=%d D=%d time=%f ms\n", M, D, t1 - t0)
    တည်ဆောက် ဒသမ t2 = mmc_now_ms()
    တည်ဆောက် ကိန်း r = 0
    ပြည့်အောင်(r < M) {
        တည်ဆောက် ကိန်း base = r * D
        တည်ဆောက် ဒသမ sum = 0
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < D) {
            sum = sum + hx[base + k]
            k = k + 1
        }
        တည်ဆောက် ဒသမ mean = sum / D
        တည်ဆောက် ဒသမ var = 0
        တည်ဆောက် ကိန်း k2 = 0
        ပြည့်အောင်(k2 < D) {
            တည်ဆောက် ဒသမ d = hx[base + k2] - mean
            var = var + d * d
            k2 = k2 + 1
        }
        var = var / D
        တည်ဆောက် ဒသမ rstd = 1.0 / sqrt(var + 0.000001)
        တည်ဆောက် ကိန်း k3 = 0
        ပြည့်အောင်(k3 < D) {
            hyc[base + k3] = (hx[base + k3] - mean) * rstd * hg[k3] + hb[k3]
            k3 = k3 + 1
        }
        r = r + 1
    }
    တည်ဆောက် ဒသမ t3 = mmc_now_ms()
    printf("LN CPU: M=%d D=%d time=%f ms\n", M, D, t3 - t2)
    printf("LN speedup = %f x\n", (t3 - t2) / (t1 - t0))
    တည်ဆောက် ကိန်း bad = 0
    တည်ဆောက် ကိန်း c = 0
    ပြည့်အောင်(c < M * D) {
        တည်ဆောက် ဒသမ d = hy[c] - hyc[c]
        သုံးသပ်ချက်အရ(d < 0) { d = 0 - d }
        သုံးသပ်ချက်အရ(d > 0.000001) { bad = bad + 1 }
        c = c + 1
    }
    သုံးသပ်ချက်အရ(bad == 0) { printf("LN BENCH MATCH — GPU = CPU\n") }
    ပြန်ပေး bad
}
