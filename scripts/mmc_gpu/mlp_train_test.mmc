ကမ္ဘာလုံး လုပ်ငန်း mm_k(ဒသမ* a, ဒသမ* b, ဒသမ* c, ကိန်း M, ကိန်း N, ကိန်း K) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < M) {
        တည်ဆောက် ကိန်း col = 0
        ပြည့်အောင်(col < N) {
            တည်ဆောက် ဒသမ sum = 0
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < K) {
                sum = sum + a[row * K + k] * b[k * N + col]
                k = k + 1
            }
            c[row * N + col] = sum
            col = col + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း gelu_kernel(ဒသမ* x, ဒသမ* y, ကိန်း n) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ v = x[i]
        y[i] = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)))
    }
}
ကမ္ဘာလုံး လုပ်ငန်း gelu_bwd(ဒသမ* dg, ဒသမ* f1, ဒသမ* dof1, ကိန်း n, ကိန်း pad2, ကိန်း pad3) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ dgi = dg[i]
        တည်ဆောက် ဒသမ v = f1[i]
        တည်ဆောက် ဒသမ th = tanh(0.7978845608 * (v + 0.044715 * v * v * v))
        dof1[i] = dgi * (0.5 * (1.0 + th) + v * 0.5 * (1.0 - th * th) * 0.7978845608 * (1.0 + 3.0 * 0.044715 * v * v))
    }
}
ကမ္ဘာလုံး လုပ်ငန်း mse_bwd(ဒသမ* o, ဒသမ* y, ဒသမ* out, ကိန်း n, ကိန်း pad1, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        out[i] = o[i] - y[i]
    }
}
ကမ္ဘာလုံး လုပ်ငန်း tpose_rc(ဒသမ* x, ဒသမ* out, ဒသမ* pad, ကိန်း R, ကိန်း C, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < C) {
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < R) {
            out[row * R + i] = x[i * C + row]
            i = i + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း bwd_dw(ဒသမ* x, ဒသမ* g, ဒသမ* out, ကိန်း N, ကိန်း K, ကိန်း R) void {
    တည်ဆောက် ကိန်း kk = MMC_BID
    သုံးသပ်ချက်အရ(kk < K) {
        တည်ဆောက် ကိန်း nn = 0
        ပြည့်အောင်(nn < N) {
            တည်ဆောက် ဒသမ sum = 0
            တည်ဆောက် ကိန်း r = 0
            ပြည့်အောင်(r < R) {
                sum = sum + x[r * K + kk] * g[r * N + nn]
                r = r + 1
            }
            out[kk * N + nn] = sum
            nn = nn + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း adamw_k(ဒသမ* w, ဒသမ* g, ဒသမ* mv, ကိန်း n, ကိန်း t, ကိန်း pad) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ m = mv[2 * i]
        တည်ဆောက် ဒသမ v = mv[2 * i + 1]
        တည်ဆောက် ဒသမ gi = g[i]
        m = 0.9 * m + 0.1 * gi
        v = 0.999 * v + 0.001 * gi * gi
        mv[2 * i] = m
        mv[2 * i + 1] = v
        တည်ဆောက် ဒသမ mhat = m / (1.0 - pow(0.9, t))
        တည်ဆောက် ဒသမ vhat = v / (1.0 - pow(0.999, t))
        w[i] = w[i] - 0.01 * mhat / (sqrt(vhat) + 0.00000001)
    }
}
လုပ်ငန်း main() {
    တည်ဆောက် ကိန်း T = 8
    တည်ဆောက် ကိန်း d = 8
    တည်ဆောက် ကိန်း H = 32
    တည်ဆောက် ကိန်း bad = 0
    တည်ဆောက် ကိန်း tstep = 1
    တည်ဆောက် ဒသမ* hH1 = mmc_malloc(512)
    တည်ဆောက် ဒသမ* hW1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hW2 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hY = mmc_malloc(512)
    တည်ဆောက် ဒသမ* hF1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hG = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hF2 = mmc_malloc(512)
    တည်ဆောက် ဒသမ* hDF2 = mmc_malloc(512)
    တည်ဆောက် ဒသမ* hW2t = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hDG = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hDF1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hDW1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hDW2 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hMV1 = mmc_malloc(4096)
    တည်ဆောက် ဒသမ* hMV2 = mmc_malloc(4096)
    တည်ဆောက် ဒသမ* hW1n = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hW2n = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hF1b = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hGb = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* hF2b = mmc_malloc(512)
    တည်ဆောက် ဒသမ* hZ = mmc_malloc(4096)
    တည်ဆောက် ဒသမ* rF1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rG = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rF2 = mmc_malloc(512)
    တည်ဆောက် ဒသမ* rDF2 = mmc_malloc(512)
    တည်ဆောက် ဒသမ* rW2t = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rDG = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rDF1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rDW1 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rDW2 = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rMV1 = mmc_malloc(4096)
    တည်ဆောက် ဒသမ* rMV2 = mmc_malloc(4096)
    တည်ဆောက် ဒသမ* rW1n = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rW2n = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rF1b = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rGb = mmc_malloc(2048)
    တည်ဆောက် ဒသမ* rF2b = mmc_malloc(512)
    တည်ဆောက် ဒသမ* dH1 = mmc_gpu_malloc(512)
    တည်ဆောက် ဒသမ* dW1 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dW2 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dY = mmc_gpu_malloc(512)
    တည်ဆောက် ဒသမ* dF1 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dG = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dF2 = mmc_gpu_malloc(512)
    တည်ဆောက် ဒသမ* dDF2 = mmc_gpu_malloc(512)
    တည်ဆောက် ဒသမ* dW2t = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dDG = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dDF1 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dDW1 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dDW2 = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dMV1 = mmc_gpu_malloc(4096)
    တည်ဆောက် ဒသမ* dMV2 = mmc_gpu_malloc(4096)
    တည်ဆောက် ဒသမ* dF1b = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dGb = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dF2b = mmc_gpu_malloc(512)
    တည်ဆောက် ကိန်း iH1 = 0
    ပြည့်အောင်(iH1 < 64) {
        hH1[iH1] = ((iH1 % 6) * 0.08 - 0.24) + (iH1 % 4) * 0.011
        iH1 = iH1 + 1
    }
    တည်ဆောက် ကိန်း iW1 = 0
    ပြည့်အောင်(iW1 < 256) {
        hW1[iW1] = ((iW1 % 11) * 0.04 - 0.22)
        iW1 = iW1 + 1
    }
    တည်ဆောက် ကိန်း iW2 = 0
    ပြည့်အောင်(iW2 < 256) {
        hW2[iW2] = ((iW2 % 13) * 0.03 - 0.18)
        iW2 = iW2 + 1
    }
    တည်ဆောက် ကိန်း iY = 0
    ပြည့်အောင်(iY < 64) {
        hY[iY] = ((iY % 9) * 0.05 - 0.2)
        iY = iY + 1
    }
    တည်ဆောက် ကိန်း iZ = 0
    ပြည့်အောင်(iZ < 512) {
        hZ[iZ] = 0.0
        iZ = iZ + 1
    }
    mmc_gpu_copy_to(dH1, hH1, 512)
    mmc_gpu_copy_to(dW1, hW1, 2048)
    mmc_gpu_copy_to(dW2, hW2, 2048)
    mmc_gpu_copy_to(dY, hY, 512)
    mmc_gpu_copy_to(dMV1, hZ, 4096)
    mmc_gpu_copy_to(dMV2, hZ, 4096)
    mmc_gpu_launch3p3i(mm_k, dH1, dW1, dF1, T, H, d, T, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch2pi(gelu_kernel, dF1, dG, 256, 1, 256)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(mm_k, dG, dW2, dF2, T, d, H, T, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(mse_bwd, dF2, dY, dDF2, 64, 0, 0, 1, 64)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(tpose_rc, dW2, dW2t, dW2t, H, d, 0, d, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(mm_k, dDF2, dW2t, dDG, T, H, d, T, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(gelu_bwd, dDG, dF1, dDF1, 256, 0, 0, 1, 256)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(bwd_dw, dH1, dDF1, dDW1, H, d, T, d, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(bwd_dw, dG, dDF2, dDW2, d, H, T, H, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(adamw_k, dW1, dDW1, dMV1, 256, tstep, 0, 256, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(adamw_k, dW2, dDW2, dMV2, 256, tstep, 0, 256, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(mm_k, dH1, dW1, dF1b, T, H, d, T, 1)
    cudaDeviceSynchronize()
    mmc_gpu_launch2pi(gelu_kernel, dF1b, dGb, 256, 1, 256)
    cudaDeviceSynchronize()
    mmc_gpu_launch3p3i(mm_k, dGb, dW2, dF2b, T, d, H, T, 1)
    cudaDeviceSynchronize()
    mmc_gpu_copy_from(hF1, dF1, 2048)
    mmc_gpu_copy_from(hG, dG, 2048)
    mmc_gpu_copy_from(hF2, dF2, 512)
    mmc_gpu_copy_from(hDF2, dDF2, 512)
    mmc_gpu_copy_from(hDG, dDG, 2048)
    mmc_gpu_copy_from(hDF1, dDF1, 2048)
    mmc_gpu_copy_from(hDW1, dDW1, 2048)
    mmc_gpu_copy_from(hDW2, dDW2, 2048)
    mmc_gpu_copy_from(hW1n, dW1, 2048)
    mmc_gpu_copy_from(hW2n, dW2, 2048)
    mmc_gpu_copy_from(hMV1, dMV1, 4096)
    mmc_gpu_copy_from(hMV2, dMV2, 4096)
    mmc_gpu_copy_from(hF1b, dF1b, 2048)
    mmc_gpu_copy_from(hGb, dGb, 2048)
    mmc_gpu_copy_from(hF2b, dF2b, 512)
    တည်ဆောက် ဒသမ loss1 = 0
    တည်ဆောက် ကိန်း ilG1 = 0
    ပြည့်အောင်(ilG1 < 64) {
        တည်ဆောက် ဒသမ eG1 = hF2[ilG1] - hY[ilG1]
        loss1 = loss1 + eG1 * eG1
        ilG1 = ilG1 + 1
    }
    loss1 = loss1 * 0.5
    တည်ဆောက် ဒသမ loss2 = 0
    တည်ဆောက် ကိန်း ilG2 = 0
    ပြည့်အောင်(ilG2 < 64) {
        တည်ဆောက် ဒသမ eG2 = hF2b[ilG2] - hY[ilG2]
        loss2 = loss2 + eG2 * eG2
        ilG2 = ilG2 + 1
    }
    loss2 = loss2 * 0.5
    တည်ဆောက် ကိန်း ra = 0
    ပြည့်အောင်(ra < T) {
        တည်ဆောက် ကိန်း rb = 0
        ပြည့်အောင်(rb < H) {
            တည်ဆောက် ဒသမ rc = 0
            တည်ဆောက် ကိန်း rk = 0
            ပြည့်အောင်(rk < d) {
                rc = rc + hH1[ra * d + rk] * hW1[rk * H + rb]
                rk = rk + 1
            }
            rF1[ra * H + rb] = rc
            rb = rb + 1
        }
        ra = ra + 1
    }
    တည်ဆောက် ကိန်း rgi = 0
    ပြည့်အောင်(rgi < 256) {
        တည်ဆောက် ဒသမ rgv = rF1[rgi]
        rG[rgi] = 0.5 * rgv * (1.0 + tanh(0.7978845608 * (rgv + 0.044715 * rgv * rgv * rgv)))
        rgi = rgi + 1
    }
    တည်ဆောက် ကိန်း ra2 = 0
    ပြည့်အောင်(ra2 < T) {
        တည်ဆောက် ကိန်း rb2 = 0
        ပြည့်အောင်(rb2 < d) {
            တည်ဆောက် ဒသမ rc2 = 0
            တည်ဆောက် ကိန်း rk2 = 0
            ပြည့်အောင်(rk2 < H) {
                rc2 = rc2 + rG[ra2 * H + rk2] * hW2[rk2 * d + rb2]
                rk2 = rk2 + 1
            }
            rF2[ra2 * d + rb2] = rc2
            rb2 = rb2 + 1
        }
        ra2 = ra2 + 1
    }
    တည်ဆောက် ကိန်း rdi = 0
    ပြည့်အောင်(rdi < 64) {
        rDF2[rdi] = rF2[rdi] - hY[rdi]
        rdi = rdi + 1
    }
    တည်ဆောက် ကိန်း rti = 0
    ပြည့်အောင်(rti < d) {
        တည်ဆောက် ကိန်း rtj = 0
        ပြည့်အောင်(rtj < H) {
            rW2t[rti * H + rtj] = hW2[rtj * d + rti]
            rtj = rtj + 1
        }
        rti = rti + 1
    }
    တည်ဆောက် ကိန်း rga = 0
    ပြည့်အောင်(rga < T) {
        တည်ဆောက် ကိန်း rgb = 0
        ပြည့်အောင်(rgb < H) {
            တည်ဆောက် ဒသမ rgc = 0
            တည်ဆောက် ကိန်း rgk = 0
            ပြည့်အောင်(rgk < d) {
                rgc = rgc + rDF2[rga * d + rgk] * rW2t[rgk * H + rgb]
                rgk = rgk + 1
            }
            rDG[rga * H + rgb] = rgc
            rgb = rgb + 1
        }
        rga = rga + 1
    }
    တည်ဆောက် ကိန်း rd1i = 0
    ပြည့်အောင်(rd1i < 256) {
        တည်ဆောက် ဒသမ rd1g = rDG[rd1i]
        တည်ဆောက် ဒသမ rd1v = rF1[rd1i]
        တည်ဆောက် ဒသမ rd1t = tanh(0.7978845608 * (rd1v + 0.044715 * rd1v * rd1v * rd1v))
        rDF1[rd1i] = rd1g * (0.5 * (1.0 + rd1t) + rd1v * 0.5 * (1.0 - rd1t * rd1t) * 0.7978845608 * (1.0 + 3.0 * 0.044715 * rd1v * rd1v))
        rd1i = rd1i + 1
    }
    တည်ဆောက် ကိန်း rw1k = 0
    ပြည့်အောင်(rw1k < d) {
        တည်ဆောက် ကိန်း rw1n = 0
        ပြည့်အောင်(rw1n < H) {
            တည်ဆောက် ဒသမ rw1s = 0
            တည်ဆောက် ကိန်း rw1r = 0
            ပြည့်အောင်(rw1r < T) {
                rw1s = rw1s + hH1[rw1r * d + rw1k] * rDF1[rw1r * H + rw1n]
                rw1r = rw1r + 1
            }
            rDW1[rw1k * H + rw1n] = rw1s
            rw1n = rw1n + 1
        }
        rw1k = rw1k + 1
    }
    တည်ဆောက် ကိန်း rw2k = 0
    ပြည့်အောင်(rw2k < H) {
        တည်ဆောက် ကိန်း rw2n = 0
        ပြည့်အောင်(rw2n < d) {
            တည်ဆောက် ဒသမ rw2s = 0
            တည်ဆောက် ကိန်း rw2r = 0
            ပြည့်အောင်(rw2r < T) {
                rw2s = rw2s + rG[rw2r * H + rw2k] * rDF2[rw2r * d + rw2n]
                rw2r = rw2r + 1
            }
            rDW2[rw2k * d + rw2n] = rw2s
            rw2n = rw2n + 1
        }
        rw2k = rw2k + 1
    }
    တည်ဆောက် ကိန်း rai = 0
    ပြည့်အောင်(rai < 256) {
        တည်ဆောက် ဒသမ rm1 = 0
        တည်ဆောက် ဒသမ rv1 = 0
        တည်ဆောက် ဒသမ rgi1 = rDW1[rai]
        rm1 = 0.9 * rm1 + 0.1 * rgi1
        rv1 = 0.999 * rv1 + 0.001 * rgi1 * rgi1
        rMV1[2 * rai] = rm1
        rMV1[2 * rai + 1] = rv1
        တည်ဆောက် ဒသမ rmh1 = rm1 / (1.0 - pow(0.9, tstep))
        တည်ဆောက် ဒသမ rvh1 = rv1 / (1.0 - pow(0.999, tstep))
        rW1n[rai] = hW1[rai] - 0.01 * rmh1 / (sqrt(rvh1) + 0.00000001)
        rai = rai + 1
    }
    တည်ဆောက် ကိန်း rbi = 0
    ပြည့်အောင်(rbi < 256) {
        တည်ဆောက် ဒသမ rm2 = 0
        တည်ဆောက် ဒသမ rv2 = 0
        တည်ဆောက် ဒသမ rgi2 = rDW2[rbi]
        rm2 = 0.9 * rm2 + 0.1 * rgi2
        rv2 = 0.999 * rv2 + 0.001 * rgi2 * rgi2
        rMV2[2 * rbi] = rm2
        rMV2[2 * rbi + 1] = rv2
        တည်ဆောက် ဒသမ rmh2 = rm2 / (1.0 - pow(0.9, tstep))
        တည်ဆောက် ဒသမ rvh2 = rv2 / (1.0 - pow(0.999, tstep))
        rW2n[rbi] = hW2[rbi] - 0.01 * rmh2 / (sqrt(rvh2) + 0.00000001)
        rbi = rbi + 1
    }
    တည်ဆောက် ကိန်း rfa = 0
    ပြည့်အောင်(rfa < T) {
        တည်ဆောက် ကိန်း rfb = 0
        ပြည့်အောင်(rfb < H) {
            တည်ဆောက် ဒသမ rfc = 0
            တည်ဆောက် ကိန်း rfk = 0
            ပြည့်အောင်(rfk < d) {
                rfc = rfc + hH1[rfa * d + rfk] * rW1n[rfk * H + rfb]
                rfk = rfk + 1
            }
            rF1b[rfa * H + rfb] = rfc
            rfb = rfb + 1
        }
        rfa = rfa + 1
    }
    တည်ဆောက် ကိန်း rgi3 = 0
    ပြည့်အောင်(rgi3 < 256) {
        တည်ဆောက် ဒသမ rgv3 = rF1b[rgi3]
        rGb[rgi3] = 0.5 * rgv3 * (1.0 + tanh(0.7978845608 * (rgv3 + 0.044715 * rgv3 * rgv3 * rgv3)))
        rgi3 = rgi3 + 1
    }
    တည်ဆောက် ကိန်း rfa2 = 0
    ပြည့်အောင်(rfa2 < T) {
        တည်ဆောက် ကိန်း rfb2 = 0
        ပြည့်အောင်(rfb2 < d) {
            တည်ဆောက် ဒသမ rfc2 = 0
            တည်ဆောက် ကိန်း rfk2 = 0
            ပြည့်အောင်(rfk2 < H) {
                rfc2 = rfc2 + rGb[rfa2 * H + rfk2] * rW2n[rfk2 * d + rfb2]
                rfk2 = rfk2 + 1
            }
            rF2b[rfa2 * d + rfb2] = rfc2
            rfb2 = rfb2 + 1
        }
        rfa2 = rfa2 + 1
    }
    တည်ဆောက် ဒသမ rloss1 = 0
    တည်ဆောက် ကိန်း rli1 = 0
    ပြည့်အောင်(rli1 < 64) {
        တည်ဆောက် ဒသမ re1 = rF2[rli1] - hY[rli1]
        rloss1 = rloss1 + re1 * re1
        rli1 = rli1 + 1
    }
    rloss1 = rloss1 * 0.5
    တည်ဆောက် ဒသမ rloss2 = 0
    တည်ဆောက် ကိန်း rli2 = 0
    ပြည့်အောင်(rli2 < 64) {
        တည်ဆောက် ဒသမ re2 = rF2b[rli2] - hY[rli2]
        rloss2 = rloss2 + re2 * re2
        rli2 = rli2 + 1
    }
    rloss2 = rloss2 * 0.5
    တည်ဆောက် ကိန်း iC1 = 0
    ပြည့်အောင်(iC1 < 256) {
        တည်ဆောက် ဒသမ e1 = hF1[iC1] - rF1[iC1]
        သုံးသပ်ချက်အရ(e1 < 0) { e1 = 0 - e1 }
        သုံးသပ်ချက်အရ(e1 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e2 = hG[iC1] - rG[iC1]
        သုံးသပ်ချက်အရ(e2 < 0) { e2 = 0 - e2 }
        သုံးသပ်ချက်အရ(e2 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e3 = hDG[iC1] - rDG[iC1]
        သုံးသပ်ချက်အရ(e3 < 0) { e3 = 0 - e3 }
        သုံးသပ်ချက်အရ(e3 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e4 = hDF1[iC1] - rDF1[iC1]
        သုံးသပ်ချက်အရ(e4 < 0) { e4 = 0 - e4 }
        သုံးသပ်ချက်အရ(e4 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e5 = hDW1[iC1] - rDW1[iC1]
        သုံးသပ်ချက်အရ(e5 < 0) { e5 = 0 - e5 }
        သုံးသပ်ချက်အရ(e5 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e6 = hDW2[iC1] - rDW2[iC1]
        သုံးသပ်ချက်အရ(e6 < 0) { e6 = 0 - e6 }
        သုံးသပ်ချက်အရ(e6 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e7 = hW1n[iC1] - rW1n[iC1]
        သုံးသပ်ချက်အရ(e7 < 0) { e7 = 0 - e7 }
        သုံးသပ်ချက်အရ(e7 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e8 = hW2n[iC1] - rW2n[iC1]
        သုံးသပ်ချက်အရ(e8 < 0) { e8 = 0 - e8 }
        သုံးသပ်ချက်အရ(e8 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e9 = hF1b[iC1] - rF1b[iC1]
        သုံးသပ်ချက်အရ(e9 < 0) { e9 = 0 - e9 }
        သုံးသပ်ချက်အရ(e9 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ e10 = hGb[iC1] - rGb[iC1]
        သုံးသပ်ချက်အရ(e10 < 0) { e10 = 0 - e10 }
        သုံးသပ်ချက်အရ(e10 > 0.000001) { bad = bad + 1 }
        iC1 = iC1 + 1
    }
    တည်ဆောက် ကိန်း iC2 = 0
    ပြည့်အောင်(iC2 < 64) {
        တည်ဆောက် ဒသမ eF2 = hF2[iC2] - rF2[iC2]
        သုံးသပ်ချက်အရ(eF2 < 0) { eF2 = 0 - eF2 }
        သုံးသပ်ချက်အရ(eF2 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ eDF2 = hDF2[iC2] - rDF2[iC2]
        သုံးသပ်ချက်အရ(eDF2 < 0) { eDF2 = 0 - eDF2 }
        သုံးသပ်ချက်အရ(eDF2 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ eF2b = hF2b[iC2] - rF2b[iC2]
        သုံးသပ်ချက်အရ(eF2b < 0) { eF2b = 0 - eF2b }
        သုံးသပ်ချက်အရ(eF2b > 0.000001) { bad = bad + 1 }
        iC2 = iC2 + 1
    }
    တည်ဆောက် ကိန်း iC3 = 0
    ပြည့်အောင်(iC3 < 512) {
        တည်ဆောက် ဒသမ eMV1 = hMV1[iC3] - rMV1[iC3]
        သုံးသပ်ချက်အရ(eMV1 < 0) { eMV1 = 0 - eMV1 }
        သုံးသပ်ချက်အရ(eMV1 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ eMV2 = hMV2[iC3] - rMV2[iC3]
        သုံးသပ်ချက်အရ(eMV2 < 0) { eMV2 = 0 - eMV2 }
        သုံးသပ်ချက်အရ(eMV2 > 0.000001) { bad = bad + 1 }
        iC3 = iC3 + 1
    }
    တည်ဆောက် ဒသမ ldiff1 = loss1 - rloss1
    သုံးသပ်ချက်အရ(ldiff1 < 0) { ldiff1 = 0 - ldiff1 }
    သုံးသပ်ချက်အရ(ldiff1 > 0.000001) { bad = bad + 1 }
    တည်ဆောက် ဒသမ ldiff2 = loss2 - rloss2
    သုံးသပ်ချက်အရ(ldiff2 < 0) { ldiff2 = 0 - ldiff2 }
    သုံးသပ်ချက်အရ(ldiff2 > 0.000001) { bad = bad + 1 }
    သုံးသပ်ချက်အရ(loss1 < loss2) { bad = bad + 1 }
    printf("sample: dF1 gpu=%.10f cpu=%.10f\n", hDF1[0], rDF1[0])
    printf("sample: dW1 gpu=%.10f cpu=%.10f\n", hDW1[0], rDW1[0])
    printf("sample: W1_new gpu=%.10f cpu=%.10f\n", hW1n[0], rW1n[0])
    printf("sample: W2_new gpu=%.10f cpu=%.10f\n", hW2n[0], rW2n[0])
    printf("sample: F2_new gpu=%.10f cpu=%.10f\n", hF2b[0], rF2b[0])
    printf("loss before = %.6f after = %.6f\n", loss1, loss2)
    printf("loss cpu before = %.6f after = %.6f\n", rloss1, rloss2)
    သုံးသပ်ချက်အရ(bad > 0) {
        printf("MLP TRAIN MISMATCH — bad=%d\n", bad)
    }
    သုံးသပ်ချက်အရ(bad == 0) {
        printf("MLP TRAIN MATCH — fwd GELU MLP dF2 dG dF1 dW1 dW2 AdamW mv W1n W2n second fwd all GPU = CPU — 3776 elementwise + 2 loss checks (T=8, d=8, H=32, 1 AdamW step) — gelu tanh-approx derivative — MLP half-block trains end-to-end in pure MMC on GPU — locked kernels + gelu_bwd (new)\n")
    }
    သုံးသပ်ချက်အရ(loss2 < loss1) {
        printf("LOSS DECREASED — AdamW step works\n")
    }
    ပြန်ပေး bad
}
