        ပြည့်အောင်(w2b < d) {
            တည်ဆောက် ဒသမ w2s = 0
            တည်ဆောက် ကိန်း w2c = 0
            ပြည့်အောင်(w2c < V) {
                w2s = w2s + rdL[w2a * V + w2c] * hWo[w2b * V + w2c]
