ကမ္ဘာလုံး လုပ်ငန်း mm_k(ဒသမ* a, ဒသမ* b, ဒသမ* c, ကိန်း M, ကိန်း N, ကိန်း K) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < M) {
        တည်ဆောက် ကိန်း col = 0
        ပြည့်အောင်(col < N) {
            တည်ဆောက် ဒသမ sum = 0
            တည်ဆောက် ကိန်း k = 0
            ပြည့်အောင်(k < K) {
                sum = sum + a[row * K + k] * b[k * N + col]
                k = k + 1
            }
            c[row * N + col] = sum
            col = col + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း att_row(ဒသမ* q, ဒသမ* k, ဒသမ* s, ကိန်း m, ကိန်း n, ကိန်း d) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < n) {
        တည်ဆောက် ဒသမ acc = 0
        တည်ဆောက် ကိန်း t = 0
        ပြည့်အောင်(t < d) {
            acc = acc + q[row * d + t] * k[j * d + t]
            t = t + 1
        }
        s[row * n + j] = acc * 0.25
        j = j + 1
    }
}
ကမ္ဘာလုံး လုပ်ငန်း mask_row(ဒသမ* s, ဒသမ* pad1, ဒသမ* pad2, ကိန်း n, ကိန်း pad3, ကိန်း pad4) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < n) {
        သုံးသပ်ချက်အရ(j > row) {
            s[row * n + j] = 0 - 1000000000.0
        }
        j = j + 1
    }
}
ကမ္ဘာလုံး လုပ်ငန်း softmax_row(ဒသမ* x, ဒသမ* out, ဒသမ* pad, ကိန်း V, ကိန်း M, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < M) {
        တည်ဆောက် ဒသမ mx = x[row * V]
        တည်ဆောက် ကိန်း j = 1
        ပြည့်အောင်(j < V) {
            သုံးသပ်ချက်အရ(x[row * V + j] > mx) { mx = x[row * V + j] }
            j = j + 1
        }
        တည်ဆောက် ဒသမ sum = 0
        j = 0
        ပြည့်အောင်(j < V) {
            sum = sum + exp(x[row * V + j] - mx)
            j = j + 1
        }
        j = 0
        ပြည့်အောင်(j < V) {
            out[row * V + j] = exp(x[row * V + j] - mx) / sum
            j = j + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း tpose_row(ဒသမ* a, ဒသမ* b, ကိန်း n) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < n) {
        b[j * n + row] = a[row * n + j]
        j = j + 1
    }
}
ကမ္ဘာလုံး လုပ်ငန်း tpose_rc(ဒသမ* x, ဒသမ* out, ဒသမ* pad, ကိန်း R, ကိန်း C, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < C) {
        တည်ဆောက် ကိန်း i = 0
        ပြည့်အောင်(i < R) {
            out[row * R + i] = x[i * C + row]
            i = i + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း smax_bwd_row(ဒသမ* a, ဒသမ* g, ဒသမ* out, ကိန်း n, ကိန်း m, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    သုံးသပ်ချက်အရ(row < m) {
        တည်ဆောက် ဒသမ dot = 0
        တည်ဆောက် ကိန်း k = 0
        ပြည့်အောင်(k < n) {
            dot = dot + g[row * n + k] * a[row * n + k]
            k = k + 1
        }
        တည်ဆောက် ကိန်း j = 0
        ပြည့်အောင်(j < n) {
            out[row * n + j] = a[row * n + j] * (g[row * n + j] - dot)
            j = j + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း scale_row(ဒသမ* x, ဒသမ* out, ဒသမ* pad, ကိန်း n, ကိန်း m, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    ပြည့်အောင်(j < n) {
        out[row * n + j] = x[row * n + j] * 0.25
        j = j + 1
    }
}
ကမ္ဘာလုံး လုပ်ငန်း mse_bwd(ဒသမ* o, ဒသမ* y, ဒသမ* out, ကိန်း n, ကိန်း pad1, ကိန်း pad2) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        out[i] = o[i] - y[i]
    }
}
ကမ္ဘာလုံး လုပ်ငန်း bwd_dw(ဒသမ* x, ဒသမ* g, ဒသမ* out, ကိန်း N, ကိန်း K, ကိန်း R) void {
    တည်ဆောက် ကိန်း kk = MMC_BID
    သုံးသပ်ချက်အရ(kk < K) {
        တည်ဆောက် ကိန်း nn = 0
        ပြည့်အောင်(nn < N) {
            တည်ဆောက် ဒသမ sum = 0
            တည်ဆောက် ကိန်း r = 0
            ပြည့်အောင်(r < R) {
                sum = sum + x[r * K + kk] * g[r * N + nn]
                r = r + 1
            }
            out[kk * N + nn] = sum
            nn = nn + 1
        }
    }
}
ကမ္ဘာလုံး လုပ်ငန်း adamw_k(ဒသမ* w, ဒသမ* g, ဒသမ* mv, ကိန်း n, ကိန်း t, ကိန်း pad) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ m = mv[2 * i]
        တည်ဆောက် ဒသမ v = mv[2 * i + 1]
        တည်ဆောက် ဒသမ gi = g[i]
        m = 0.9 * m + 0.1 * gi
        v = 0.999 * v + 0.001 * gi * gi
        mv[2 * i] = m
        mv[2 * i + 1] = v
        တည်ဆောက် ဒသမ mhat = m / (1.0 - pow(0.9, t))
        တည်ဆောက် ဒသမ vhat = v / (1.0 - pow(0.999, t))
        w[i] = w[i] - 0.01 * mhat / (sqrt(vhat) + 0.00000001)
    }
}
ကမ္ဘာလုံး လုပ်ငန်း gelu_kernel(ဒသမ* x, ဒသမ* y, ကိန်း n) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ v = x[i]
        y[i] = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)))
    }
}
ကမ္ဘာလုံး လုပ်ငန်း gelu_bwd(ဒသမ* dg, ဒသမ* f1, ဒသမ* dof1, ကိန်း n, ကိန်း pad2, ကိန်း pad3) void {
    တည်ဆောက် ကိန်း i = MMC_TID
    သုံးသပ်ချက်အရ(i < n) {
        တည်ဆောက် ဒသမ dgi = dg[i]
        တည်ဆောက် ဒသမ v = f1[i]
        တည်ဆောက် ဒသမ th = tanh(0.7978845608 * (v + 0.044715 * v * v * v))
        dof1[i] = dgi * (0.5 * (1.0 + th) + v * 0.5 * (1.0 - th * th) * 0.7978845608 * (1.0 + 3.0 * 0.044715 * v * v))
    }
}
ကမ္ဘာလုံး လုပ်ငန်း ln_fwd_row(ဒသမ* x, ဒသမ* g, ဒသမ* b, ဒသမ* y, ကိန်း D, ဒသမ eps) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    တည်ဆောက် ဒသမ sum = 0
    တည်ဆောက် ဒသမ mean = 0
    တည်ဆောက် ဒသမ var = 0
    တည်ဆောက် ဒသမ rstd = 0
    တည်ဆောက် ဒသမ d = 0
    j = 0
    ပြည့်အောင်(j < D) {
        sum = sum + x[row * D + j]
        j = j + 1
    }
    mean = sum / D
    var = 0
    j = 0
    ပြည့်အောင်(j < D) {
        d = x[row * D + j] - mean
        var = var + d * d
        j = j + 1
    }
    var = var / D
    rstd = 1.0 / sqrt(var + eps)
    j = 0
    ပြည့်အောင်(j < D) {
        y[row * D + j] = (x[row * D + j] - mean) * rstd * g[j] + b[j]
        j = j + 1
    }
}
ကမ္ဘာလုံး လုပ်ငန်း ln_bwd_row(ဒသမ* dy, ဒသမ* x, ဒသမ* g, ဒသမ* dx, ကိန်း D, ဒသမ eps) void {
    တည်ဆောက် ကိန်း row = MMC_BID
    တည်ဆောက် ကိန်း j = 0
    တည်ဆောက် ဒသမ sum = 0
    တည်ဆောက် ဒသမ mean = 0
    တည်ဆောက် ဒသမ var = 0
    တည်ဆောက် ဒသမ rstd = 0
    တည်ဆောက် ဒသမ d = 0
    တည်ဆောက် ဒသမ s1 = 0
    တည်ဆောက် ဒသမ s2 = 0
    တည်ဆောက် ဒသမ a = 0
    တည်ဆောက် ဒသမ xh = 0
    j = 0
    ပြည့်အောင်(j < D) {
        sum = sum + x[row * D + j]
        j = j + 1
    }
    mean = sum / D
    var = 0
    j = 0
    ပြည့်အောင်(j < D) {
        d = x[row * D + j] - mean
        var = var + d * d
        j = j + 1
    }
    var = var / D
    rstd = 1.0 / sqrt(var + eps)
    s1 = 0
    s2 = 0
    j = 0
    ပြည့်အောင်(j < D) {
        a = dy[row * D + j] * g[j]
        xh = (x[row * D + j] - mean) * rstd
        s1 = s1 + a
        s2 = s2 + a * xh
        j = j + 1
    }
    j = 0
    ပြည့်အောင်(j < D) {
        a = dy[row * D + j] * g[j]
        xh = (x[row * D + j] - mean) * rstd
        dx[row * D + j] = rstd * (a - s1 / D - xh * s2 / D)
        j = j + 1
    }
}
