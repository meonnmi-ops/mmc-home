    တည်ဆောက် ကိန်း bc4 = 0
    ပြည့်အောင်(bc4 < 64) {
        တည်ဆောက် ဒသမ ec24 = hWq2[bc4] - rwq2[bc4]
        သုံးသပ်ချက်အရ(ec24 < 0) { ec24 = 0 - ec24 }
        သုံးသပ်ချက်အရ(ec24 > 0.000001) { bad = bad + 1 }
        တည်ဆောက် ဒသမ ec25 = hWk2[bc4] - rwk2[bc4]
        သုံးသပ်ချက်အရ(ec25 < 0) { ec25 = 0 - ec25 }
