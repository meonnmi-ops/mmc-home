    }
    တည်ဆောက် ကိန်း q1 = 0
    ပြည့်အောင်(q1 < 88) {
        rdL[q1] = rLg[q1] - hY[q1]
        q1 = q1 + 1
    }
    တည်ဆောက် ကိန်း w1a = 0
    ပြည့်အောင်(w1a < d) {
        တည်ဆောက် ကိန်း w1b = 0
        ပြည့်အောင်(w1b < V) {
            တည်ဆောက် ဒသမ w1s = 0
            တည်ဆောက် ကိန်း w1c = 0
            ပြည့်အောင်(w1c < T) {
                w1s = w1s + rH3[w1c * d + w1a] * rdL[w1c * V + w1b]
                w1c = w1c + 1
            }
            rdWo[w1a * V + w1b] = w1s
            w1b = w1b + 1
        }
        w1a = w1a + 1
    }
    တည်ဆောက် ကိန်း w2a = 0
    ပြည့်အောင်(w2a < T) {
