    mmc_gpu_copy_from(hmv1, dmv1, 4096)
    mmc_gpu_copy_from(hmv2, dmv2, 4096)
    တည်ဆောက် ကိန်း aw1 = 0
    ပြည့်အောင်(aw1 < 64) {
        တည်ဆောက် ဒသမ amq = 0.9 * rmvq[2 * aw1] + 0.1 * rdWq[aw1]
        တည်ဆောက် ဒသမ avq = 0.999 * rmvq[2 * aw1 + 1] + 0.001 * rdWq[aw1] * rdWq[aw1]
        rmvq[2 * aw1] = amq
        rmvq[2 * aw1 + 1] = avq
        တည်ဆောက် ဒသမ amhq = amq / (1.0 - pow(0.9, 1))
        တည်ဆောက် ဒသမ avhq = avq / (1.0 - pow(0.999, 1))
        rwq2[aw1] = hWq[aw1] - 0.01 * amhq / (sqrt(avhq) + 0.00000001)
        aw1 = aw1 + 1
    }
    တည်ဆောက် ကိန်း aw2 = 0
    ပြည့်အောင်(aw2 < 64) {
