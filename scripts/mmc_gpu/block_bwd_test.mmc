    တည်ဆောက် ဒသမ* dgG = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dF1g = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dw1t = mmc_gpu_malloc(2048)
    တည်ဆောက် ဒသမ* dgw1 = mmc_gpu_malloc(2048)
