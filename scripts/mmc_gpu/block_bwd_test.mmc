        တည်ဆောက် ဒသမ amhv = amv / (1.0 - pow(0.9, 1))
        တည်ဆောက် ဒသမ avhv = avv / (1.0 - pow(0.999, 1))
        rwv2[aw3] = hWv[aw3] - 0.01 * amhv / (sqrt(avhv) + 0.00000001)
