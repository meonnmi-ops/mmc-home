        printf("BLOCK BWD MATCH — full transformer block forward + backward + AdamW (Wq Wk Wv Wo W1 W2) t=1 — 5648 elementwise + loss + 28 masked-zero + rowsum + LOSS DECREASED all GPU = CPU (T=8, K=8, d=8, H=32, V=11) — ln_bwd_row chain debut — zero new kernels — locked kernels only — full block training proven in pure MMC on GPU\n")
    }
