        တည်ဆောက် ဒသမ avo = 0.999 * rmvo[2 * aw4 + 1] + 0.001 * rdWo[aw4] * rdWo[aw4]
        rmvo[2 * aw4] = amo
        rmvo[2 * aw4 + 1] = avo
        တည်ဆောက် ဒသမ amho = amo / (1.0 - pow(0.9, 1))
        တည်ဆောက် ဒသမ avho = avo / (1.0 - pow(0.999, 1))
