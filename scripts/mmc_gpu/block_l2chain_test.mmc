                တည်ဆောက် ဒသမ avoB = 0.999 * rmvoB[2 * aw4B + 1] + 0.001 * rdWoB[aw4B] * rdWoB[aw4B]
                rmvoB[2 * aw4B] = amoB
                rmvoB[2 * aw4B + 1] = avoB
                တည်ဆောက် ဒသမ amhoB = amoB / (1.0 - pow(0.9, step))
