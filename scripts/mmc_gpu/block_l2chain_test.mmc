    printf("sample: mvq2_final gpu=%.10f cpu=%.10f\n", hmvqB[0], rmvqB[0])
    သုံးသပ်ချက်အရ(lossL < lossF) {
        printf("LOSS DECREASED — 8 forward loss pairs 8 AdamW steps (t=1..8) inverse-step lr schedule both blocks persistent true-gradient m/v — L=2 chained block training works on GPU\n")
    }
    သုံးသပ်ချက်အရ(bad > 0) {
        printf("BLOCK L2CHAIN MISMATCH — bad=%d\n", bad)
    }
    သုံးသပ်ချက်အရ(bad == 0) {
        printf("BLOCK L2CHAIN MATCH — L=2 chained two-block training with deep supervision (loss = block-1 + block-2 MSE) — block-2 input = block-1 post-LN output H3 (device dh3, mirror rH3, chain width d=K=8) — chain gradient dX1 added into block-1 dH3 before LN-backward (host add + copy, zero new kernels) — scheduled update w += lrs*(w_full - w) with lrs=1/step ≡ AdamW lr 0.01/step on TRUE-gradient persistent m/v both blocks — 8 forward loss pairs + 8 AdamW steps t=1..8 (Wq Wk Wv Wo W1 W2 ×2) — 90368 elementwise + 24 loss-sync + 1 anchor (step-1 block-1 loss = task-x/y/z/aa byte-exact 2.970168) + 7 LOSS DECREASED gates + 448 masked-zero + 64 rowsum conditions all GPU = CPU (T=8, K=8, d=8, H=32, V=11) — zero new kernels — locked kernels only — L=2 chained block training proven in pure MMC on GPU\n")
    }
    ပြန်ပေး bad
}
