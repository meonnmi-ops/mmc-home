                တည်ဆောက် ဒသမ ec28B = hmvqB[2 * bc4B + 1] - rmvqB[2 * bc4B + 1]
                သုံးသပ်ချက်အရ(ec28B < 0) { ec28B = 0 - ec28B }
                သုံးသပ်ချက်အရ(ec28B > 0.000001) { bad = bad + 1 }
                တည်ဆောက် ဒသမ ec29B = hmvkB[2 * bc4B] - rmvkB[2 * bc4B]
