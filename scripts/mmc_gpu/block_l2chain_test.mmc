        printf("sample: mvq2_0 gpu=%.10f cpu=%.10f\n", hmvqB[0], rmvqB[0])
        lprev = ltot
        step = step + 1
    }
    printf("loss first = %.6f\n", lossF)
    printf("loss last  = %.6f\n", lossL)
    printf("A row0 sum=%.12f row7 sum=%.12f\n", rsF0, rsF7)
    printf("A2 row0 sum=%.12f row7 sum=%.12f\n", rsFB0, rsFB7)
