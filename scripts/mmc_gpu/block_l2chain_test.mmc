                တည်ဆောက် ဒသမ avhkB = avkB / (1.0 - pow(0.999, step))
                hWkB[aw2B] = hWkB[aw2B] - (lrs * 0.01) * amhkB / (sqrt(avhkB) + 0.00000001)
                aw2B = aw2B + 1
            }
            တည်ဆောက် ကိန်း aw3B = 0
            ပြည့်အောင်(aw3B < 64) {
                တည်ဆောက် ဒသမ amvB = 0.9 * rmvvB[2 * aw3B] + 0.1 * rdWvB[aw3B]
                တည်ဆောက် ဒသမ avvB = 0.999 * rmvvB[2 * aw3B + 1] + 0.001 * rdWvB[aw3B] * rdWvB[aw3B]
                rmvvB[2 * aw3B] = amvB
                rmvvB[2 * aw3B + 1] = avvB
                တည်ဆောက် ဒသမ amhvB = amvB / (1.0 - pow(0.9, step))
                တည်ဆောက် ဒသမ avhvB = avvB / (1.0 - pow(0.999, step))
                hWvB[aw3B] = hWvB[aw3B] - (lrs * 0.01) * amhvB / (sqrt(avhvB) + 0.00000001)
